---
import { SUPPORT_EMAIL, WHATSAPP_NUMBER, whatsappUrl } from '../lib/contact';

const supportEmail = SUPPORT_EMAIL;
const whatsappHref = whatsappUrl('Hi CRTL U Digital, I have a question about your TV boxes or projectors.');
---

<footer class="site-footer" id="contact">
  <div class="footer-inner">
    <section class="footer-contact" aria-labelledby="footer-contact-title">
      <div>
        <div class="eyebrow" data-i18n="footer.support.eyebrow">Customer support</div>
        <h2 id="footer-contact-title" data-i18n="footer.support.title">Need help before or after an order?</h2>
        <p data-i18n="footer.support.body">
          Contact us for product questions, order status, shipping updates, and after-sales support.
          Please include your order email or Stripe checkout email when asking about an existing order.
        </p>
      </div>
      <div class="contact-actions">
        <a class="primary-button" href={`mailto:${supportEmail}`} data-i18n="footer.emailSupport">Email support</a>
        {WHATSAPP_NUMBER && whatsappHref && <a class="secondary-button" href={whatsappHref} target="_blank" rel="noopener noreferrer" data-i18n="footer.whatsapp">WhatsApp</a>}
        <a class="secondary-button" href="/contact/" data-i18n="footer.contactPage">Contact page</a>
      </div>
    </section>

    <div class="footer-grid">
      <div>
        <strong>CRTLU Digital</strong>
        <p data-i18n="footer.brand.blurb">TV boxes, compact projectors, and home cinema gear for official apps and user-owned subscriptions.</p>
      </div>
      <div>
        <strong data-i18n="footer.col.contact">Contact</strong>
        <p><a href={`mailto:${supportEmail}`}>{supportEmail}</a></p>
        {WHATSAPP_NUMBER && whatsappHref && <p><a href={whatsappHref} target="_blank" rel="noopener noreferrer" data-i18n="footer.whatsappChat">WhatsApp chat</a></p>}
        <p data-i18n="footer.replyTime">Typical reply: within 24 business hours.</p>
      </div>
      <div>
        <strong data-i18n="footer.col.order">Order Support</strong>
        <p><a href="/success/" data-i18n="footer.orderStatus">Check order status</a></p>
        <p><a href="/account/" data-i18n="footer.memberAccount">Member account</a></p>
      </div>
      <div>
        <strong data-i18n="footer.col.policies">Policies</strong>
        <p><a href="/shipping/" data-i18n="footer.shipping">Shipping</a></p>
        <p><a href="/returns/" data-i18n="footer.returns">Returns & refunds</a></p>
        <p><a href="/warranty/" data-i18n="footer.warranty">Limited warranty</a></p>
      </div>
      <div>
        <strong data-i18n="footer.col.terms">Store Terms</strong>
        <p><a href="/privacy/" data-i18n="footer.privacy">Privacy</a></p>
        <p><a href="/terms/" data-i18n="footer.terms">Terms of service</a></p>
        <p data-i18n="footer.payNote">Stripe payment · Yanwen tracking</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 56px 0 40px;
    border-top: 1px solid var(--line);
    background: #0a0a0a;
    color: #fff;
  }

  .footer-inner {
    width: min(var(--max), calc(100% - 32px));
    margin: 0 auto;
  }

  .footer-contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px;
    align-items: end;
    padding: 28px 0 36px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .footer-contact .eyebrow {
    color: rgba(255, 255, 255, 0.55);
  }

  .footer-contact h2 {
    margin: 10px 0 12px;
    max-width: 700px;
    color: #fff;
    font-size: clamp(24px, 3vw, 36px);
  }

  .footer-contact p {
    max-width: 720px;
    color: rgba(255, 255, 255, 0.68);
  }

  .contact-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .site-footer .primary-button {
    background: #fff;
    color: #111;
    border-color: #fff;
  }

  .site-footer .secondary-button {
    background: transparent;
    color: #fff;
    border-color: rgba(255, 255, 255, 0.4);
  }

  .site-footer .secondary-button:hover {
    background: #fff;
    color: #111;
    border-color: #fff;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.3fr repeat(4, 1fr);
    gap: 22px;
    margin-top: 28px;
    color: rgba(255, 255, 255, 0.62);
    font-size: 13px;
    line-height: 1.65;
  }

  .footer-grid strong {
    display: block;
    margin-bottom: 10px;
    color: #fff;
    font-family: var(--font-sans);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-grid a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(255, 255, 255, 0.35);
  }

  .footer-grid a:hover {
    text-decoration-color: #fff;
  }

  @media (max-width: 920px) {
    .footer-contact,
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .contact-actions {
      justify-content: flex-start;
    }
  }
</style>
