---
import { SUPPORT_EMAIL, WHATSAPP_NUMBER, whatsappUrl } from '../lib/contact';

const supportEmail = SUPPORT_EMAIL;
const whatsappHref = whatsappUrl('Hi CRTL U Digital, I have a question about your TV boxes or projectors.');
---

<footer class="site-footer" id="contact">
  <div class="footer-inner">
    <section class="footer-contact" aria-labelledby="footer-contact-title">
      <div>
        <div class="eyebrow">Customer support</div>
        <h2 id="footer-contact-title">Need help before or after an order?</h2>
        <p>
          Contact us for product questions, order status, shipping updates, and after-sales support.
          Please include your order email or Stripe checkout email when asking about an existing order.
        </p>
      </div>
      <div class="contact-actions">
        <a class="primary-button" href={`mailto:${supportEmail}`}>Email support</a>
        {WHATSAPP_NUMBER && whatsappHref && <a class="secondary-button" href={whatsappHref} target="_blank" rel="noopener noreferrer">WhatsApp</a>}
        <a class="secondary-button" href="/contact/">Contact page</a>
      </div>
    </section>

    <div class="footer-grid">
      <div>
        <strong>CRTLU Digital</strong>
        <p>TV boxes, compact projectors, and home cinema gear for official apps and user-owned subscriptions.</p>
      </div>
      <div>
        <strong>Contact</strong>
        <p><a href={`mailto:${supportEmail}`}>{supportEmail}</a></p>
        {WHATSAPP_NUMBER && whatsappHref && <p><a href={whatsappHref} target="_blank" rel="noopener noreferrer">WhatsApp chat</a></p>}
        <p>Typical reply: within 24 business hours.</p>
      </div>
      <div>
        <strong>Order Support</strong>
        <p><a href="/success/">Check order status</a></p>
        <p><a href="/account/">Member account</a></p>
      </div>
      <div>
        <strong>Store Details</strong>
        <p>Payment: Stripe Checkout</p>
        <p>Fulfillment: Yanwen tracked shipping</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 44px 0;
    border-top: 1px solid var(--line);
    background:
      radial-gradient(circle at 78% 12%, rgba(93, 231, 255, 0.1), transparent 28%),
      #020405;
  }

  .footer-inner {
    width: min(var(--max), calc(100% - 32px));
    margin: 0 auto;
  }

  .footer-contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px;
    align-items: end;
    padding: 24px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.035);
  }

  .footer-contact h2 {
    margin: 8px 0 10px;
    max-width: 700px;
    font-size: clamp(26px, 3vw, 38px);
  }

  .footer-contact p {
    max-width: 720px;
    color: #c6d3da;
  }

  .contact-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.3fr repeat(3, 1fr);
    gap: 18px;
    margin-top: 22px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
  }

  .footer-grid strong {
    display: block;
    margin-bottom: 8px;
    color: var(--text);
  }

  .footer-grid a {
    color: var(--cyan);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 920px) {
    .footer-contact,
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .contact-actions {
      justify-content: flex-start;
    }
  }
</style>
