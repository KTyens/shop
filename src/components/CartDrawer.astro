---
import '../styles/global.css';
---

<div class="drawer-backdrop" id="cartBackdrop"></div>
<aside class="cart-drawer" id="cartDrawer" aria-label="Shopping cart" aria-hidden="true">
  <div class="cart-head">
    <h2>Your cart</h2>
    <button class="icon-button" type="button" id="closeCart" aria-label="Close cart">
      <span class="close-icon" aria-hidden="true"></span>
    </button>
  </div>
  <div class="cart-items" id="cartItems">
    <div class="empty">Your cart is empty.</div>
  </div>
  <div class="cart-foot">
    <div class="summary-line">
      <span>Subtotal</span>
      <span id="cartSubtotal">$0.00</span>
    </div>
    <div class="summary-line">
      <span>Estimated shipping</span>
      <span id="cartShipping">$12.00</span>
    </div>
    <div class="summary-line discount" id="discountLine" hidden>
      <span>Coupon discount</span>
      <span id="cartDiscount">-$0.00</span>
    </div>
    <div class="summary-line total">
      <span>Total</span>
      <span id="cartTotal">$0.00</span>
    </div>
    <div class="phase4-controls">
      <label>
        <span>Currency</span>
        <select id="currencySelect">
          <option value="USD">USD ($)</option>
          <option value="JPY">JPY (¥)</option>
          <option value="CNY">CNY (¥)</option>
          <option value="EUR">EUR (€)</option>
        </select>
      </label>
      <label>
        <span>Language</span>
        <select id="localeSelect">
          <option value="en">English</option>
          <option value="ja">日本語</option>
          <option value="zh-CN">简体中文</option>
          <option value="zh-TW">繁體中文</option>
          <option value="es">Español</option>
          <option value="pt">Português</option>
          <option value="id">Bahasa Indonesia</option>
          <option value="th">ไทย</option>
          <option value="vi">Tiếng Việt</option>
          <option value="ms">Bahasa Melayu</option>
        </select>
      </label>
    </div>
    <div class="coupon-box">
      <label>
        <span>Coupon</span>
        <input id="couponCode" type="text" placeholder="WELCOME5" />
      </label>
      <button type="button" id="applyCoupon">Apply</button>
      <button type="button" id="clearCoupon">Clear</button>
    </div>
    <div class="status" id="couponStatus"></div>
    <button class="primary-button" type="button" id="checkoutButton" style="width:100%">Checkout with Stripe</button>
    <div class="status" id="checkoutStatus"></div>
  </div>
</aside>
