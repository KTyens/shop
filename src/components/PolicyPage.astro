---
import Layout from '../layouts/Layout.astro';
import Navigation from './Navigation.astro';
import { SUPPORT_EMAIL } from '../lib/contact';

type PolicySection = {
  id: string;
  title: string;
  paragraphs?: string[];
  bullets?: string[];
};

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  canonicalPath: string;
  keywords?: string[];
  updated?: string;
  sections: PolicySection[];
}

const {
  eyebrow,
  title,
  description,
  canonicalPath,
  keywords = [],
  updated = 'July 13, 2026',
  sections,
} = Astro.props;
---

<Layout
  title={`${title} | CRTL U Digital`}
  description={description}
  canonicalPath={canonicalPath}
  keywords={keywords}
>
  <Navigation showCart={false} />

<main class="policy-page" id="main-content">
    <header class="policy-hero wrap">
      <div class="eyebrow">{eyebrow}</div>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <p class="policy-updated">Last updated: {updated}</p>
    </header>

    <div class="policy-layout wrap">
      <nav class="policy-nav" aria-label={`${title} sections`}>
        <strong>On this page</strong>
        {sections.map((section) => <a href={`#${section.id}`}>{section.title}</a>)}
      </nav>

      <article class="policy-content">
        <p class="policy-scope">
          This policy applies to products purchased directly from <strong>shop.crtlu.me</strong>.
        </p>
        {sections.map((section) => (
          <section id={section.id} class="policy-section">
            <h2>{section.title}</h2>
            {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
            {section.bullets && (
              <ul>
                {section.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            )}
          </section>
        ))}

        <section class="policy-contact" aria-labelledby="policy-contact-title">
          <div>
            <div class="eyebrow">Need clarification?</div>
            <h2 id="policy-contact-title">Contact us before ordering.</h2>
            <p>We can confirm product compatibility, destination availability, and policy details for your order.</p>
          </div>
          <a class="primary-button" href={`mailto:${SUPPORT_EMAIL}`}>Email support</a>
        </section>
      </article>
    </div>
  </main>
</Layout>

<style>
  .policy-page {
    padding-bottom: 72px;
  }

  .policy-hero {
    padding: 72px 0 42px;
    border-bottom: 1px solid var(--line);
  }

  .policy-hero h1 {
    max-width: 880px;
  }

  .policy-hero .lead {
    max-width: 760px;
  }

  .policy-updated {
    margin-top: 18px;
    color: var(--muted);
    font-size: 12px;
    text-transform: uppercase;
  }

  .policy-layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 760px);
    gap: 56px;
    justify-content: center;
    padding-top: 42px;
  }

  .policy-nav {
    position: sticky;
    top: 92px;
    align-self: start;
    display: grid;
    gap: 4px;
    border-left: 1px solid var(--line);
    padding-left: 16px;
  }

  .policy-nav strong {
    margin-bottom: 8px;
    color: var(--text);
    font-size: 13px;
  }

  .policy-nav a {
    padding: 7px 0;
    color: var(--muted);
    font-size: 13px;
  }

  .policy-nav a:hover {
    color: var(--cyan);
  }

  .policy-content {
    min-width: 0;
  }

  .policy-scope {
    margin-bottom: 34px;
    padding: 16px 18px;
    border: 1px solid rgba(0,0,0,0.08);
    background: rgba(0,0,0,0.08);
    color: #dce8ed;
  }

  .policy-section {
    padding: 0 0 34px;
    scroll-margin-top: 100px;
  }

  .policy-section + .policy-section {
    padding-top: 34px;
    border-top: 1px solid var(--line);
  }

  .policy-section h2,
  .policy-contact h2 {
    margin: 0 0 16px;
    font-size: clamp(25px, 3vw, 36px);
  }

  .policy-section p,
  .policy-section li,
  .policy-contact p {
    color: #666666;
    font-size: 15px;
    line-height: 1.75;
  }

  .policy-section p + p {
    margin-top: 12px;
  }

  .policy-section ul {
    display: grid;
    gap: 10px;
    margin-top: 14px;
    padding-left: 22px;
  }

  .policy-contact {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-top: 12px;
    padding: 24px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, .035);
  }

  .policy-contact p {
    max-width: 540px;
  }

  .policy-contact .primary-button {
    flex: 0 0 auto;
  }

  @media (max-width: 820px) {
    .policy-hero {
      padding-top: 48px;
    }

    .policy-layout {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .policy-nav {
      position: static;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border: 1px solid var(--line);
      padding: 14px;
    }

    .policy-nav strong {
      grid-column: 1 / -1;
    }

    .policy-contact {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
