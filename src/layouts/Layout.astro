---
import '../styles/global.css';
import i18nScriptUrl from '../../assets/i18n.js?url';
import phase4ScriptUrl from '../../assets/shop-phase4.js?url';
import accountNavScriptUrl from '../../assets/account-nav.js?url';
import Footer from '../components/Footer.astro';
import WhatsAppChat from '../components/WhatsAppChat.astro';
import { absoluteUrl, DEFAULT_OG_IMAGE, SITE_NAME } from '../lib/seo';

const {
  title = 'CRTLU Digital | Premium TV Boxes & Projectors',
  description = 'Premium Android TV boxes, Google TV streamers, and compact projectors for cinematic home entertainment.',
  keywords = [],
  canonicalPath = Astro.url.pathname,
  image = DEFAULT_OG_IMAGE,
  type = 'website',
  robots = 'index, follow',
  jsonLd = [],
} = Astro.props;

// Prefer same-origin /api (Cloudflare Pages proxies to Serv00). Avoids CORS "Failed to fetch"
// when the browser talks to api.crtlu.me cross-origin. Override with PUBLIC_CRTLU_API_BASE_URL only if needed.
const configuredApiBase = (import.meta.env.PUBLIC_CRTLU_API_BASE_URL || '').trim();
const apiBaseUrl = (configuredApiBase || '/api').replace(/\/+$/, '');
const canonicalUrl = absoluteUrl(canonicalPath);
const imageUrl = absoluteUrl(image);
const keywordContent = Array.isArray(keywords)
  ? [...new Set(keywords.map((keyword) => String(keyword).trim()).filter(Boolean))].join(', ')
  : String(keywords || '');
const jsonLdItems = Array.isArray(jsonLd) ? jsonLd : [jsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/assets/brand-mark.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywordContent && <meta name="keywords" content={keywordContent} />}
    <meta name="robots" content={robots} />
    <meta name="author" content={SITE_NAME} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="text/plain" href={absoluteUrl('/llms.txt')} title="LLM store summary" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {jsonLdItems.filter(Boolean).map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
    <slot name="head" />
    <script define:vars={{ apiBaseUrl }}>
      (() => {
        const base = apiBaseUrl || '/api';
        const normalizedBase = base.replace(/\/+$/, '') || '/api';

        window.CRTLU_CONFIG = Object.freeze({
          apiBaseUrl: normalizedBase,
        });

        window.crtluApiUrl = (path) => {
          let value = String(path || '').trim();
          if (/^https?:\/\//i.test(value)) return value;
          value = value.replace(/^\/+/, '');
          if (value.startsWith('api/')) value = value.slice(4);
          return `${normalizedBase}/${value}`;
        };
      })();
    </script>
    <script src={i18nScriptUrl} defer></script>
    <script src={phase4ScriptUrl} defer></script>
    <script src={accountNavScriptUrl} defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
    <Footer />
    <WhatsAppChat />
  </body>
</html>
