---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="Payment received | CRTLU Digital" description="Your payment was accepted. Order confirmation and next steps." canonicalPath="/success/" robots="noindex, follow">
  <main id="main-content" style="min-height:100vh;display:grid;place-items:center;padding:22px;">
    <div style="width:min(680px,100%);padding:36px;border:1px solid rgba(139,255,133,.22);background:rgba(8,16,23,.86);box-shadow:0 30px 90px rgba(0,0,0,.45);">
      <h1 style="margin:0 0 12px;font-size:42px;line-height:1;">Payment received.</h1>
      <p style="color:#aebbc4;line-height:1.7;margin:0 0 18px;">Your payment was accepted by Stripe. CRTL U Digital will prepare fulfillment and attach a Yanwen tracking number after shipment.</p>

      <div class="panel" id="orderPanel" style="margin-top:18px;padding:16px;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.04);">
        <div class="status" style="color:var(--green);font-weight:800;">Checking order confirmation...</div>
        <p class="muted" style="color:var(--muted);margin:8px 0 0;font-size:14px;">Stripe webhooks can take a few seconds to write the order into the store database.</p>
      </div>

      <a class="secondary-button" href="/" style="display:inline-flex;margin-top:18px;color:var(--text);text-decoration:none;">Back to shop</a>
    </div>
  </main>

  <script>
    const panel = document.getElementById('orderPanel');
    const params = new URLSearchParams(window.location.search);
    const sessionId = params.get('session_id');
    const money = (cents, currency) => `${(currency || 'USD').toUpperCase()} ${(Number(cents || 0) / 100).toFixed(2)}`;
    const apiUrl = path => window.crtluApiUrl ? window.crtluApiUrl(path) : path;

    let attempts = 0;

    async function checkOrder() {
      if (!sessionId) {
        panel.innerHTML = `<div class="status" style="color:var(--green);font-weight:800;">Payment completed</div><p class="muted" style="color:var(--muted);margin:8px 0 0;font-size:14px;">No session ID found. Your order was processed successfully.</p>`;
        return;
      }

      attempts += 1;
      try {
        const response = await fetch(apiUrl(`/api/order-status.php?session_id=${encodeURIComponent(sessionId)}`), {
          credentials: 'include',
        });
        const payload = await response.json();
        if (payload.found) {
          const items = (payload.items || []).map(item => `<li style="font-size:14px;">${item.quantity} x ${item.product_name}</li>`).join('');
          panel.innerHTML = `
            <div class="status" style="color:var(--green);font-weight:800;">Order #${payload.order.id} confirmed</div>
            <p class="muted" style="color:var(--muted);margin:8px 0 0;font-size:14px;">Status: ${payload.order.status} / Total: ${money(payload.order.amount_total, payload.order.currency)}</p>
            ${items ? `<ul style="margin:10px 0 0;padding-left:18px;color:#c9d8df;font-size:14px;">${items}</ul>` : ''}
          `;
          return;
        }
        if (attempts < 8) {
          setTimeout(checkOrder, 1800);
          return;
        }
        panel.innerHTML = `<div class="status" style="color:var(--green);font-weight:800;">Payment completed</div><p class="muted" style="color:var(--muted);margin:8px 0 0;font-size:14px;">Order details will appear once the webhook is received.</p>`;
      } catch {
        panel.innerHTML = `<div class="status" style="color:var(--green);font-weight:800;">Payment completed</div><p class="muted" style="color:var(--muted);margin:8px 0 0;font-size:14px;">Order lookup is temporarily unavailable. Your payment was successful.</p>`;
      }
    }

    checkOrder();
  </script>
</Layout>
