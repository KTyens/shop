---
import { loadCatalog, loadPlugTypes } from '../../lib/catalog-data';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import CartDrawer from '../../components/CartDrawer.astro';
import PlugSelectorStyles from '../../components/PlugSelectorStyles.astro';
import '../../styles/global.css';
import { productJsonLd, productKeywords } from '../../lib/seo';

const allSeries = loadCatalog();
const plugTypes = loadPlugTypes();

export async function getStaticPaths() {
  const catalog = loadCatalog();
  return catalog.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

const productSlug = Astro.params.slug;
const product = (Astro.props.product) || allSeries[0];

function flattenVariants(items: any[]) {
  return items.flatMap(item =>
    item.variants.map(v => ({
      ...v,
      seriesId: item.id,
      seriesName: item.name,
      brand: item.brand,
      tier: item.tier,
      category: item.category,
      image: item.image,
    }))
  );
}

const variants = flattenVariants(allSeries);
const productPayload = product;
const variantsPayload = variants;
const plugTypesPayload = plugTypes;
const productSeoKeywords = productKeywords(product);
const productTitle = `${product.name} ${product.category === 'projector' ? 'Home Cinema Projector' : 'Android TV Box'} | CRTL U Digital`;
const productDescription = `${product.description} Shop ${product.name} configurations with secure Stripe checkout, Yanwen tracked shipping, and no preloaded paid content.`;
const productSchema = productJsonLd(product);
const isProjector = product.category === 'projector';
const buyerFit = isProjector
  ? 'Home movie nights, bedroom viewing, casual gaming, and portable big-screen setups.'
  : product.tier === 'budget'
    ? 'Essential streaming, local media playback, and a lower-cost secondary TV setup.'
    : product.tier === 'flagship' || product.tier === 'performance'
      ? 'Buyers comparing stronger chipsets, larger memory options, faster networking, and demanding media playback.'
      : 'Everyday family streaming, official apps, local media, and a balanced living-room setup.';
const packageContents = isProjector
  ? 'Projector, remote control, selected power adapter, and the documentation or accessories shown for this model.'
  : 'TV box, remote control, HDMI cable, selected power adapter, and the documentation or accessories shown for this model.';
const faqItems = [
  {
    question: 'Does this product include paid channels or streaming subscriptions?',
    answer: 'No. CRTL U Digital sells the hardware only. Use official apps and your own valid subscriptions. No IPTV access, paid channel bundle, or unofficial streaming account is included.',
  },
  {
    question: 'Which power adapter plug should I choose?',
    answer: 'Choose the wall-plug type used at the delivery destination: UK Plug (BS 1363), EU Plug (Europlug), or US Plug (NEMA 1-15). The selected type is stored with the order and shown to our fulfillment team.',
  },
  {
    question: 'How much is shipping and how long does delivery take?',
    answer: 'Yanwen tracked shipping is USD 12 per order. Orders normally take 1–3 business days to process, followed by an estimated 7–18 business days in transit. Customs or local-carrier delays can extend this estimate.',
  },
  {
    question: 'What happens if the parcel arrives damaged or the wrong item is sent?',
    answer: 'Contact support within 7 calendar days after delivery with the order email, shipping-label and packaging photos, and clear photos or video of the issue. We will review the evidence and provide an appropriate solution.',
  },
  {
    question: 'Can I return the product and is there a warranty?',
    answer: 'Return requests should be made within 14 calendar days after delivery. Unless a product page states otherwise, physical devices include a 12-month limited hardware warranty for verified manufacturing defects. Policy exclusions apply.',
  },
  {
    question: 'Are Netflix, YouTube, Google TV, or other third-party apps guaranteed?',
    answer: 'App availability, certification, playback resolution, subscriptions, and regional restrictions are controlled by each third-party provider and can change. Check the required app and region before purchase if it is essential to your setup.',
  },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<Layout
  title={productTitle}
  description={productDescription}
  keywords={productSeoKeywords}
  canonicalPath={`/products/${product.id}/`}
  image={product.image}
  type="product"
  jsonLd={[productSchema, faqSchema]}
>
  <Navigation />
  <CartDrawer />
  <PlugSelectorStyles />

  <main class="product-detail-page" id="main-content">
    <section class="hero detail-hero" style="width:min(var(--max),calc(100% - 32px));margin:0 auto;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(360px,.95fr);align-items:start;gap:34px;padding:42px 0 48px;">
      <div>
        <div class="gallery-main" id="galleryMain" style="min-height:520px;display:grid;place-items-center;padding:24px;border:1px solid var(--line);background:radial-gradient(circle at 50% 38%,rgba(93,231,255,.12),transparent 48%),linear-gradient(180deg,rgba(247,250,252,.96),rgba(217,228,234,.9));overflow:hidden;"></div>
        <div class="thumbs" id="thumbs" style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-top:12px;"></div>
      </div>
      <div>
        <div class="eyebrow" id="eyebrow">{product.brand} / {product.tier.replace('-', ' ')}</div>
        <h1 id="title">{product.name}</h1>
        <p class="lead" id="description" style="color:#c6d3da;line-height:1.7;font-size:17px;margin:14px 0;">{product.description}</p>
        <div class="price-line" style="margin:22px 0;display:flex;align-items:end;gap:10px;">
          <span class="price" id="price" style="font-size:38px;font-weight:950;">$0.00</span>
          <span class="compare" id="compare" style="color:var(--muted);text-decoration:line-through;"></span>
        </div>
        <div class="variants" id="variants" style="display:grid;gap:10px;margin:22px 0;"></div>
        <div class="plug-section" id="plugSection" style="display:grid;gap:10px;margin:22px 0;"></div>
        <div class="actions" style="display:flex;flex-wrap:wrap;gap:10px;margin-top:18px;">
          <button class="primary-button" type="button" id="addSelected">Add to Cart</button>
          <a class="secondary-button" href="/products/">All Products</a>
        </div>
        <div class="buy-trust">
          <span>Stripe secure checkout</span>
          <a href="/shipping/">Tracked delivery: 7–18 business days</a>
          <a href="/returns/">14-day return request window</a>
          <a href="/warranty/">12-month limited hardware warranty</a>
        </div>
      </div>
    </section>

    <section class="purchase-guide section" aria-labelledby="purchase-guide-title">
      <div class="section-heading-row">
        <div>
          <div class="eyebrow">Buy with the right expectations</div>
          <h2 id="purchase-guide-title">Before you order</h2>
        </div>
        <a class="secondary-button" href="/contact/">Ask a compatibility question</a>
      </div>
      <div class="purchase-guide-grid">
        <article class="purchase-guide-item">
          <span>01 / Best for</span>
          <h3>{buyerFit}</h3>
          <p>Compare the chipset, memory, connectivity, and operating system below against the apps and display you plan to use.</p>
        </article>
        <article class="purchase-guide-item">
          <span>02 / In the box</span>
          <h3>{packageContents}</h3>
          <p>The product gallery and packing-list image take priority if a production batch contains different accessories.</p>
        </article>
        <article class="purchase-guide-item">
          <span>03 / Delivery & support</span>
          <h3>Tracked shipping, clear policies, human support.</h3>
          <p>Standard shipping is USD 12 per order. Contact support with your order email for delivery, setup, return, or warranty help.</p>
        </article>
      </div>
    </section>

    <section class="section" style="padding:34px 0;border-top:1px solid var(--line);">
      <h2 style="margin:0 0 18px;font-size:28px;">Specifications</h2>
      <div class="spec-grid" id="specGrid" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;"></div>
    </section>

    <section class="section" style="padding:34px 0;border-top:1px solid var(--line);">
      <h2 style="margin:0 0 18px;font-size:28px;">Product Images</h2>
      <div class="detail-gallery" id="detailGallery" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;"></div>
    </section>

    <section class="product-faq section" aria-labelledby="product-faq-title">
      <div class="section-heading-row">
        <div>
          <div class="eyebrow">Purchase questions</div>
          <h2 id="product-faq-title">Good to know before checkout</h2>
        </div>
        <a class="secondary-button" href="/contact/">Contact support</a>
      </div>
      <div class="faq-list">
        {faqItems.map((item, index) => (
          <details class="faq-item" open={index === 0}>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
      <div class="policy-link-row" aria-label="Store policies">
        <a href="/shipping/">Shipping policy</a>
        <a href="/returns/">Returns & refunds</a>
        <a href="/warranty/">Limited warranty</a>
        <a href="/terms/">Terms of service</a>
      </div>
    </section>
  </main>

  <!-- Lightbox -->
  <div class="lightbox" id="imageLightbox" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Product image preview">
    <div class="lightbox-inner">
      <div class="lightbox-head">
        <span id="lightboxCaption">{product.name}</span>
        <button class="icon-button" type="button" id="closeLightbox" aria-label="Close image preview"><span class="close-icon" aria-hidden="true"></span></button>
      </div>
      <div class="lightbox-frame" id="lightboxFrame"></div>
    </div>
  </div>

  <style is:global>
    .product-detail-page > .section {
      width: min(var(--max), calc(100% - 32px));
      margin-right: auto;
      margin-left: auto;
    }

    .buy-trust {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      margin-top: 16px;
    }

    .buy-trust span,
    .buy-trust a {
      min-height: 48px;
      display: flex;
      align-items: center;
      padding: 10px;
      border: 1px solid rgba(139, 255, 133, .22);
      background: rgba(139, 255, 133, .06);
      color: #c6d3da;
      font-size: 12px;
      line-height: 1.35;
    }

    .buy-trust a:hover {
      border-color: rgba(93, 231, 255, .48);
      color: var(--cyan);
    }

    .purchase-guide,
    .product-faq {
      padding: 50px 0;
      border-top: 1px solid var(--line);
    }

    .section-heading-row {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 24px;
      margin-bottom: 28px;
    }

    .section-heading-row h2 {
      margin-top: 10px;
      font-size: clamp(28px, 4vw, 46px);
    }

    .purchase-guide-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }

    .purchase-guide-item {
      min-width: 0;
      padding: 24px 24px 28px 0;
    }

    .purchase-guide-item + .purchase-guide-item {
      padding-left: 24px;
      border-left: 1px solid var(--line);
    }

    .purchase-guide-item > span {
      color: var(--green);
      font-size: 11px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: .08em;
    }

    .purchase-guide-item h3 {
      margin: 14px 0 12px;
      font-size: 19px;
      line-height: 1.35;
    }

    .purchase-guide-item p {
      color: var(--muted);
      line-height: 1.7;
    }

    .faq-list {
      border-top: 1px solid var(--line);
    }

    .faq-item {
      border-bottom: 1px solid var(--line);
    }

    .faq-item summary {
      position: relative;
      padding: 21px 48px 21px 0;
      color: var(--text);
      font-size: 16px;
      font-weight: 800;
      line-height: 1.45;
      cursor: pointer;
      list-style: none;
    }

    .faq-item summary::-webkit-details-marker {
      display: none;
    }

    .faq-item summary::after {
      content: '+';
      position: absolute;
      top: 50%;
      right: 8px;
      transform: translateY(-50%);
      color: var(--cyan);
      font-size: 24px;
      font-weight: 400;
    }

    .faq-item[open] summary::after {
      content: '−';
    }

    .faq-item p {
      max-width: 850px;
      padding: 0 48px 22px 0;
      color: #c6d3da;
      font-size: 14px;
      line-height: 1.75;
    }

    .policy-link-row {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 20px;
      margin-top: 22px;
    }

    .policy-link-row a {
      color: var(--cyan);
      font-size: 13px;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .lightbox {
      position: fixed;
      inset: 0;
      z-index: 120;
      display: none;
      place-items: center;
      padding: 22px;
      background: rgba(0, 0, 0, 0.86);
      backdrop-filter: blur(14px);
    }

    .lightbox-inner {
      width: min(1120px, 100%);
      max-height: 92vh;
      display: grid;
      gap: 12px;
    }

    .lightbox-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      color: var(--muted);
      font-size: 13px;
    }

    .lightbox-frame {
      min-height: 0;
      display: grid;
      place-items: center;
      border: 1px solid var(--line);
      background: linear-gradient(180deg, rgba(247, 250, 252, .98), rgba(220, 230, 236, .94));
    }

    .lightbox-image {
      max-width: 100%;
      max-height: 82vh;
      object-fit: contain;
      padding: 18px;
      filter: drop-shadow(0 24px 36px rgba(0, 0, 0, .32));
    }

    @media (max-width: 560px) {
      .product-detail-page > .section {
        width: calc(100% - 24px);
      }

      .buy-trust,
      .purchase-guide-grid {
        grid-template-columns: 1fr;
      }

      .spec-grid {
        grid-template-columns: 1fr !important;
      }

      .spec,
      .spec span,
      .spec strong {
        min-width: 0;
        overflow-wrap: anywhere;
      }

      .section-heading-row {
        align-items: flex-start;
        flex-direction: column;
      }

      .purchase-guide-item,
      .purchase-guide-item + .purchase-guide-item {
        padding: 22px 0;
        border-left: 0;
      }

      .purchase-guide-item + .purchase-guide-item {
        border-top: 1px solid var(--line);
      }

      .lightbox {
        align-items: stretch;
        justify-items: stretch;
        padding: 0;
        background: #000;
        backdrop-filter: none;
      }

      .lightbox-inner {
        width: 100vw;
        height: 100dvh;
        max-height: none;
        display: block;
      }

      .lightbox-head {
        position: fixed;
        top: max(10px, env(safe-area-inset-top));
        left: 12px;
        right: 12px;
        z-index: 2;
        padding: 8px 0;
        color: #fff;
        text-shadow: 0 1px 10px rgba(0, 0, 0, .78);
      }

      .lightbox-head .icon-button {
        background: rgba(0, 0, 0, .52);
        border-color: rgba(255, 255, 255, .3);
      }

      .lightbox-frame {
        width: 100vw;
        height: 100dvh;
        border: 0;
        background: #000;
      }

      .lightbox-image {
        width: 100vw;
        height: 100dvh;
        max-width: 100vw;
        max-height: 100dvh;
        padding: 0;
        object-fit: contain;
        filter: none;
      }
    }
  </style>

  <script define:vars={{ productPayload, variantsPayload, plugTypesPayload }}>
    window.__PRODUCT__ = productPayload;
    window.__VARIANTS__ = variantsPayload;
    window.__PLUG_TYPES__ = plugTypesPayload;
  </script>

  <script>
    // ---- Product detail page logic ----
    const product = window.__PRODUCT__;
    const variants = Array.isArray(window.__VARIANTS__) ? window.__VARIANTS__ : [];
    const SHIPPING_CENTS = 1200;
    const cartKey = 'crtlu-cart-v1';
    const PLUG_TYPES = (Array.isArray(window.__PLUG_TYPES__) && window.__PLUG_TYPES__.length ? window.__PLUG_TYPES__ : [
      { id: 'uk', label: 'UK Plug', code: 'BS 1363' },
      { id: 'eu', label: 'EU Plug', code: 'Europlug' },
      { id: 'us', label: 'US Plug', code: 'NEMA 1-15' },
    ]);

    let selectedId = null;
    let selectedPlug = '';
    let currentImage = '';
    let phase4ControlsReady = false;
    let cart = (() => {
      try { return JSON.parse(localStorage.getItem(cartKey) || '[]'); } catch { return []; }
    })();

    function variantById(id) { return variants.find(v => v.id === id); }
    function plugById(id) { return PLUG_TYPES.find(p => p.id === id); }
    function plugLabel(id) {
      const plug = plugById(id);
      return plug ? `${plug.label}${plug.code ? ` (${plug.code})` : ''}` : '';
    }
    function isValidPlug(id) { return Boolean(plugById(id)); }
    function saveCart() { localStorage.setItem(cartKey, JSON.stringify(cart)); }
    function money(cents) { return '$' + (cents / 100).toFixed(2); }
    function apiUrl(path) { return window.crtluApiUrl ? window.crtluApiUrl(path) : path; }

    function renderProduct() {
      const selected = product.variants.find((v) => v.id === selectedId) || product.variants[0];
      selectedId = selected.id;
      const gallerySource = [
        product.image,
        ...(Array.isArray(product.gallery) ? product.gallery : []),
      ].filter(Boolean);
      const gallery = [...new Set(gallerySource)];
      currentImage = currentImage || gallery[0] || '';

      document.getElementById('price').textContent = money(selected.price_cents);
      document.getElementById('compare').textContent = (selected.compare_at_cents && selected.compare_at_cents !== selected.price_cents) ? money(selected.compare_at_cents) : '';

      // Gallery
      document.getElementById('galleryMain').innerHTML = currentImage
        ? `<button class="gallery-main-button" type="button" data-lightbox-image="${currentImage}" aria-label="Open image"><img class="gallery-main-image" src="${currentImage}" alt="${product.name}" fetchpriority="high" decoding="async"></button>`
        : '';

      document.getElementById('thumbs').innerHTML = gallery.map((img, i) =>
        `<button class="thumb ${img === currentImage ? 'active' : ''}" type="button" data-image="${img}" aria-label="Show image" aria-current="${img === currentImage ? 'true' : 'false'}"><img class="thumb-image" src="${img}" alt="${product.name}" loading="${i === 0 ? 'eager' : 'lazy'}" decoding="async"></button>`
      ).join('');

      // Variants
      document.getElementById('variants').innerHTML = product.variants.map((v) =>
        `<button class="variant-row ${v.id === selected.id ? 'active' : ''}" type="button" data-variant="${v.id}"><span><strong>${v.label}</strong><span>${v.sku}</span></span><strong>${money(v.price_cents)}</strong></button>`
      ).join('');

      // Plug type selector
      const plugHtml = PLUG_TYPES.map(p =>
        `<button class="plug-option ${p.id === selectedPlug ? 'active' : ''}" type="button" data-plug="${p.id}">
          <span class="plug-icon">
            <span class="plug-${p.id}-body">
              ${p.id === 'uk' ? '<span class="uk-pin"></span><span class="uk-pin-l"></span><span class="uk-pin-r"></span>' : ''}
              ${p.id === 'eu' ? '<span class="eu-pin"></span><span class="eu-pin"></span>' : ''}
              ${p.id === 'us' ? '<span class="us-pin"></span><span class="us-pin"></span><span class="us-ground"></span>' : ''}
            </span>
          </span>
          <span class="plug-option-label">${p.label}</span>
          <span class="plug-option-sublabel">${p.code || ''}</span>
        </button>`
      ).join('');
      document.getElementById('plugSection').innerHTML = `
        <div class="plug-section-title">Power Adapter Plug Type <span class="plug-required">*</span></div>
        <p class="plug-helper">Choose the wall plug that matches the destination country before checkout.</p>
        <div class="plug-selector">${plugHtml}</div>
      `;

      // Specs
      const baseSpecs = {
        Brand: product.brand,
        Category: product.category.replace('-', ' '),
        Tier: product.tier.replace('-', ' '),
        Configurations: product.variants.map((v) => v.label).join(' / '),
        SKU: selected.sku,
        'Launch Price': money(selected.price_cents),
        'Standard Price': money(selected.compare_at_cents || selected.price_cents),
      };
      const hiddenCatalogKeys = new Set([
        'brand',
        'category',
        'tier',
        'configurations',
        'sku',
        'starting_price',
        'shipping_baseline',
        'product',
        'model',
      ]);
      const specEntries = Object.entries(baseSpecs);
      Object.entries(product.specs || {}).forEach(([key, val]) => {
        if (!hiddenCatalogKeys.has(key.toLowerCase()) && val) specEntries.push([key, val]);
      });
      document.getElementById('specGrid').innerHTML = specEntries.filter(([, val]) => val).map(([key, val]) =>
        `<div class="spec" style="padding:16px;border:1px solid var(--line);background:rgba(255,255,255,.04);"><span style="display:block;color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.08em;">${key}</span><strong style="display:block;margin-top:8px;line-height:1.4;">${val}</strong></div>`
      ).join('');

      // Detail gallery
      document.getElementById('detailGallery').innerHTML = gallery.map((img, i) =>
        `<button class="detail-gallery-button" type="button" data-lightbox-image="${img}" aria-label="Detail image ${i + 1}"><img class="detail-gallery-image" src="${img}" alt="${product.name} detail ${i + 1}" loading="lazy" decoding="async"></button>`
      ).join('');
    }

    function openLightbox(image) {
      if (!image) return;
      document.body.style.overflow = 'hidden';
      document.getElementById('lightboxCaption').textContent = product.name;
      document.getElementById('lightboxFrame').innerHTML = `<img class="lightbox-image" src="${image}" alt="${product.name} enlarged">`;
      document.getElementById('imageLightbox').style.display = 'grid';
      document.getElementById('imageLightbox').setAttribute('aria-hidden', 'false');
    }

    function closeLightbox() {
      document.getElementById('imageLightbox').style.display = 'none';
      document.getElementById('imageLightbox').setAttribute('aria-hidden', 'true');
      document.getElementById('lightboxFrame').innerHTML = '';
      if (!document.getElementById('cartDrawer').classList.contains('open')) document.body.style.overflow = '';
    }

    function renderCart() {
      cart = cart.filter(item => variantById(item.id) && isValidPlug(item.plug));
      saveCart();
      const count = cart.reduce((s, i) => s + i.qty, 0);
      const subtotal = cart.reduce((s, i) => s + variantById(i.id).price_cents * i.qty, 0);
      const shipping = subtotal > 0 ? SHIPPING_CENTS : 0;
      const phase4 = window.CRTLU_PHASE4;
      const formatMoney = phase4?.formatMoney || money;

      document.getElementById('cartCount').textContent = String(count);
      document.getElementById('cartSubtotal').textContent = formatMoney(subtotal);
      document.getElementById('cartShipping').textContent = subtotal > 0 ? formatMoney(shipping) : formatMoney(0);
      document.getElementById('cartTotal').textContent = formatMoney(subtotal + shipping);
      if (phase4?.renderAdjustments) phase4.renderAdjustments(subtotal, shipping);
      document.getElementById('checkoutButton').disabled = count === 0;

      document.getElementById('cartItems').innerHTML = cart.length
        ? cart.map((item, index) => {
            const v = variantById(item.id);
            if (!v) return '';
            return `<div class="cart-item"><img class="cart-thumb" src="${v.image || product.image}" alt="${v.seriesName}" loading="lazy" decoding="async"><div><h3>${v.seriesName}</h3><p>${v.label} / ${v.sku}<br><strong class="cart-plug">${plugLabel(item.plug)}</strong></p><div class="quantity"><button class="qty-btn" type="button" data-cart-index="${index}" data-change="-1">-</button><span>${item.qty}</span><button class="qty-btn" type="button" data-cart-index="${index}" data-change="1">+</button></div><button class="remove" type="button" data-remove-index="${index}">Remove</button></div><strong class="cart-price">${money(v.price_cents * item.qty)}</strong></div>`;
          }).join('')
        : '<div class="empty" style="color:var(--muted);padding:30px 0;line-height:1.6;">Your cart is empty.</div>';

      document.querySelectorAll('[data-cart-index]').forEach(btn => {
        btn.addEventListener('click', () => {
          const index = parseInt(btn.dataset.cartIndex, 10);
          const change = parseInt(btn.dataset.change);
          const item = cart[index];
          if (item) { item.qty = Math.max(1, item.qty + change); saveCart(); renderCart(); }
        });
      });
      document.querySelectorAll('[data-remove-index]').forEach(btn => {
        btn.addEventListener('click', () => {
          const index = parseInt(btn.dataset.removeIndex, 10);
          cart = cart.filter((_, itemIndex) => itemIndex !== index);
          saveCart(); renderCart();
        });
      });
    }

    function openCart() {
      document.body.style.overflow = 'hidden';
      document.getElementById('cartDrawer').classList.add('open');
      document.getElementById('cartDrawer').setAttribute('aria-hidden', 'false');
      document.getElementById('cartBackdrop').classList.add('open');
    }
    function closeCart() {
      document.body.style.overflow = '';
      document.getElementById('cartDrawer').classList.remove('open');
      document.getElementById('cartDrawer').setAttribute('aria-hidden', 'true');
      document.getElementById('cartBackdrop').classList.remove('open');
    }

    function addToCart(id) {
      if (!selectedPlug) {
        const section = document.getElementById('plugSection');
        if (section) {
          section.scrollIntoView({ behavior: 'smooth', block: 'center' });
          section.querySelector('.plug-required')?.setAttribute('style', 'animation:pulse 1s ease 3;');
        }
        return;
      }
      const existing = cart.find(i => i.id === id && i.plug === selectedPlug);
      if (existing) existing.qty += 1;
      else cart.push({ id, qty: 1, plug: selectedPlug });
      saveCart(); renderCart(); openCart();
    }

    function initPhase4Controls() {
      const phase4 = window.CRTLU_PHASE4;
      if (phase4ControlsReady || !phase4?.initControls) return;
      phase4ControlsReady = true;
      phase4.initControls({
        validateUrl: apiUrl('/api/validate-coupon.php'),
        getItems: () => cart,
        onChange: renderCart,
      });
      renderCart();
    }

    async function checkout() {
      const status = document.getElementById('checkoutStatus');
      status.className = 'status';
      status.textContent = 'Creating checkout session...';
      const phase4 = window.CRTLU_PHASE4;
      const checkoutMeta = phase4?.checkoutMeta ? phase4.checkoutMeta() : {};
      if (!cart.every(item => isValidPlug(item.plug))) {
        status.className = 'status error';
        status.textContent = 'Please choose a power adapter plug type for every item.';
        return;
      }
      try {
        const response = await fetch(apiUrl('/api/create-checkout-session.php'), {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: cart, ...checkoutMeta }),
        });
        const payload = phase4?.readJsonResponse
          ? await phase4.readJsonResponse(response, 'Checkout API returned an empty response.')
          : await response.json();
        if (!response.ok || !payload.url) throw new Error(payload.error || 'Checkout not configured');
        window.location.href = payload.url;
      } catch (error) {
        status.className = 'status error';
        status.textContent = error instanceof Error ? error.message : 'Something went wrong';
      }
    }

    // ---- Init ----
    function init() {
      selectedId = product.variants[0].id;
      selectedPlug = '';
      currentImage = '';

      renderProduct();
      renderCart();

      // Event delegation
      document.addEventListener('click', event => {
        const lb = event.target as HTMLElement;
        const lightboxTrigger = lb.closest('[data-lightbox-image]') as HTMLElement | null;
        if (lightboxTrigger?.dataset.lightboxImage) openLightbox(lightboxTrigger.dataset.lightboxImage);
        if (event.target === document.getElementById('imageLightbox')) closeLightbox();

        const thumb = lb.closest('[data-image]');
        if (thumb) { currentImage = thumb.dataset.image; renderProduct(); }

        const variant = lb.closest('[data-variant]');
        if (variant) { selectedId = variant.dataset.variant; renderProduct(); }

        const plug = lb.closest('[data-plug]');
        if (plug) { selectedPlug = plug.dataset.plug; renderProduct(); }
      });

      document.getElementById('addSelected').addEventListener('click', () => addToCart(selectedId));
      document.getElementById('openCart').addEventListener('click', openCart);
      document.getElementById('mobileOpenCart')?.addEventListener('click', openCart);
      document.getElementById('closeCart').addEventListener('click', closeCart);
      document.getElementById('cartBackdrop').addEventListener('click', closeCart);
      document.getElementById('checkoutButton').addEventListener('click', checkout);
      initPhase4Controls();
      window.addEventListener('crtlu:phase4-ready', initPhase4Controls);
      document.getElementById('closeLightbox').addEventListener('click', closeLightbox);
      document.addEventListener('keydown', e => { if (e.key === 'Escape' && document.getElementById('imageLightbox').style.display === 'grid') closeLightbox(); });
    }

    init();
  </script>
</Layout>
