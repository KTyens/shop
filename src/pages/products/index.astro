---
import { loadCatalog, loadPlugTypes } from '../../lib/catalog-data';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import CartDrawer from '../../components/CartDrawer.astro';
import PlugSelectorStyles from '../../components/PlugSelectorStyles.astro';
import '../../styles/global.css';
import { absoluteUrl, BRAND_DISCOVERY_KEYWORDS, CORE_SEO_KEYWORDS, SAFE_COMMERCE_KEYWORDS } from '../../lib/seo';

const series = loadCatalog();
const plugTypes = loadPlugTypes();

const catalogPayload = series;
const plugTypesPayload = plugTypes;
const catalogKeywords = [
  ...CORE_SEO_KEYWORDS,
  ...BRAND_DISCOVERY_KEYWORDS,
  ...SAFE_COMMERCE_KEYWORDS,
  ...series.map((item) => item.name),
  ...series.map((item) => item.brand),
  'compare Android TV boxes',
  'Android TV box catalog',
  '4K set-top box',
  'streaming box for home cinema',
];
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'CRTLU Digital Android TV Box and Projector Catalog',
  itemListElement: series.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: absoluteUrl(`/products/${item.id}/`),
    name: item.name,
  })),
};
---

<Layout
  title="All Android TV Boxes, TV Set-Top Boxes & Projectors | CRTL U Digital"
  description="Browse Android TV boxes, Google TV streamers, 4K set-top boxes, HK1, H96Max, Tanix, T95, X5, and compact projectors by brand, tier, configuration, and price."
  keywords={catalogKeywords}
  canonicalPath="/products/"
  image="/assets/hero-cinema.png"
  jsonLd={itemListJsonLd}
>
  <Navigation />
  <CartDrawer />
  <PlugSelectorStyles />

  <main>
    <section class="hero wrap">
      <div class="eyebrow">Complete Catalog</div>
      <h1>All active Android TV box and projector gear.</h1>
      <p class="lead">Browse the models currently published for independent-store sales, including Android TV boxes, TV set-top boxes, 4K streaming devices, compact projectors, and home cinema gear. The homepage stays focused on a few hero products; this page keeps the full catalog searchable and ready for checkout.</p>

      <div class="catalog-console" aria-label="Catalog controls">
        <div class="catalog-controls">
          <label class="search-field">
            <span class="sr-only">Search catalog</span>
            <input type="search" id="catalogSearch" placeholder="Search model, brand, SKU, chipset..." />
            <button class="clear-search" type="button" id="clearSearch" aria-label="Clear search">×</button>
          </label>
          <label class="sort-field">
            <span class="sr-only">Sort catalog</span>
            <select id="catalogSort" aria-label="Sort catalog">
              <option value="featured">Featured order</option>
              <option value="price-asc">Price: low to high</option>
              <option value="price-desc">Price: high to low</option>
              <option value="name-asc">Name: A to Z</option>
            </select>
          </label>
        </div>
        <div class="toolbar" id="filters"></div>
        <div class="summary" id="summary">Loading catalog...</div>
      </div>
    </section>

    <section class="wrap">
      <div class="product-grid" id="productGrid"></div>
    </section>
  </main>

  <!-- Inject catalog data as a global variable -->
  <script define:vars={{ catalogPayload, plugTypesPayload }}>
    window.__CATALOG__ = catalogPayload;
    window.__PLUG_TYPES__ = plugTypesPayload;
  </script>

  <script>
    // ---- Client-side interactivity ----

    const catalogData = Array.isArray(window.__CATALOG__) ? window.__CATALOG__ : [];
    const PLUG_TYPES = (Array.isArray(window.__PLUG_TYPES__) && window.__PLUG_TYPES__.length ? window.__PLUG_TYPES__ : [
      { id: 'uk', label: 'UK Plug', code: 'BS 1363' },
      { id: 'eu', label: 'EU Plug', code: 'Europlug' },
      { id: 'us', label: 'US Plug', code: 'NEMA 1-15' },
    ]);

    const SHIPPING_CENTS = 1200;
    const cartKey = 'crtlu-cart-v1';

    interface Variant {
      id: string;
      label: string;
      sku: string;
      price_cents: number;
      compare_at_cents?: number;
      seriesId?: string;
      seriesName?: string;
      brand?: string;
      tier?: string;
      category?: string;
      description?: string;
    }

    interface PlugType {
      id: string;
      label: string;
      code?: string;
    }

    interface SeriesItem {
      id: string;
      name: string;
      brand: string;
      tier: string;
      category: string;
      description: string;
      image: string;
      variants: Variant[];
      specs?: Record<string, string>;
      detail_url?: string;
    }

    let variants: Variant[] = [];
    let activeFilter = 'all';
    let searchQuery = '';
    let sortMode = 'featured';
    let selected: Record<string, string> = {};
    let selectedPlugs: Record<string, string> = {};
    let plugWarnings: Record<string, boolean> = {};
    let cart: Array<{ id: string; qty: number; plug?: string }> = loadCart();
    let phase4ControlsReady = false;

    function flattenVariants(series: SeriesItem[]) {
      return series.flatMap(item =>
        item.variants.map(variant => ({
          ...variant,
          seriesId: item.id,
          seriesName: item.name,
          brand: item.brand,
          tier: item.tier,
          category: item.category,
          description: item.description,
        }))
      );
    }

    function variantById(id: string) {
      return variants.find(v => v.id === id);
    }

    function plugById(id?: string): PlugType | undefined {
      return PLUG_TYPES.find((plug: PlugType) => plug.id === id);
    }

    function plugLabel(id?: string): string {
      const plug = plugById(id);
      return plug ? `${plug.label}${plug.code ? ` (${plug.code})` : ''}` : '';
    }

    function isValidPlug(id?: string): boolean {
      return Boolean(plugById(id));
    }

    function loadCart() {
      try {
        const parsed = JSON.parse(localStorage.getItem(cartKey) || '[]');
        return Array.isArray(parsed) ? parsed : [];
      } catch {
        return [];
      }
    }

    function saveCart() {
      localStorage.setItem(cartKey, JSON.stringify(cart));
    }

    function apiUrl(path: string) {
      return (window as any).crtluApiUrl ? (window as any).crtluApiUrl(path) : path;
    }

    function minPrice(item: SeriesItem) {
      return Math.min(...item.variants.map(v => v.price_cents));
    }

    function filterLabel(filterId: string): string {
      if (filterId === 'all') return 'All';
      if (filterId.startsWith('category:')) {
        const cat = filterId.slice(9);
        return cat === 'tv-box' ? 'TV Boxes' : cat === 'premium' ? 'Premium' : cat === 'projector' ? 'Projectors' : cat;
      }
      if (filterId.startsWith('brand:')) return filterId.slice(6);
      if (filterId.startsWith('tier:')) {
        const tierMap: Record<string, string> = {
          budget: 'Budget', 'best-value': 'Best Value', main: 'Main',
          performance: 'Performance', flagship: 'Flagship'
        };
        return tierMap[filterId.slice(5)] || filterId.slice(5);
      }
      return filterId;
    }

    function searchableText(item: SeriesItem) {
      return [
        item.id, item.name, item.brand, item.category, item.tier, item.description,
        ...(item.specs ? Object.values(item.specs) : []),
        ...item.variants.flatMap(v => [v.id, v.label, v.sku, String(v.price_cents)]),
      ].join(' ').toLowerCase();
    }

    function filteredCatalog() {
      const query = searchQuery.trim().toLowerCase();
      const queryTokens = query.split(/\s+/).filter(Boolean);
      let items = catalogData;

      if (activeFilter.startsWith('category:'))
        items = items.filter(item => item.category === activeFilter.slice(9));
      else if (activeFilter.startsWith('brand:'))
        items = items.filter(item => item.brand === activeFilter.slice(6));
      else if (activeFilter.startsWith('tier:'))
        items = items.filter(item => item.tier === activeFilter.slice(5));

      if (queryTokens.length)
        items = items.filter(item => queryTokens.every(token => searchableText(item).includes(token)));

      const sorted = [...items];
      if (sortMode === 'price-asc') sorted.sort((a, b) => minPrice(a) - minPrice(b) || a.name.localeCompare(b.name));
      if (sortMode === 'price-desc') sorted.sort((a, b) => minPrice(b) - minPrice(a) || a.name.localeCompare(b.name));
      if (sortMode === 'name-asc') sorted.sort((a, b) => a.name.localeCompare(b.name));

      return sorted;
    }

    function renderProducts() {
      const items = filteredCatalog();
      const variantCount = items.reduce((sum, item) => sum + item.variants.length, 0);

      document.getElementById('summary')!.innerHTML =
        `<strong>${items.length}</strong> models / <strong>${variantCount}</strong> configs / Filter: <strong>${filterLabel(activeFilter)}</strong>` +
        (searchQuery.trim() ? ` / Search: "${searchQuery.trim()}"` : '');

      if (!items.length) {
        document.getElementById('productGrid')!.innerHTML = `
          <div class="empty-state">
            <div>
              <strong>No matches found</strong><br />
              Try adjusting your search or filters.
            </div>
          </div>`;
        return;
      }

      document.getElementById('productGrid')!.innerHTML = items.map(item => {
        const selectedId = selected[item.id] || item.variants[0].id;
        const selectedPlug = selectedPlugs[item.id] || '';
        const needsPlug = Boolean(plugWarnings[item.id]);
        const current = item.variants.find(v => v.id === selectedId) || item.variants[0];

        const plugHtml = PLUG_TYPES.map((p: PlugType) =>
          `<button class="plug-option ${p.id === selectedPlug ? 'active' : ''}" type="button" data-plug="${item.id}:${p.id}">
            <span class="plug-icon">
              <span class="plug-${p.id}-body">
                ${p.id === 'uk' ? '<span class="uk-pin"></span><span class="uk-pin-l"></span><span class="uk-pin-r"></span>' : ''}
                ${p.id === 'eu' ? '<span class="eu-pin"></span><span class="eu-pin"></span>' : ''}
                ${p.id === 'us' ? '<span class="us-pin"></span><span class="us-pin"></span><span class="us-ground"></span>' : ''}
              </span>
            </span>
            <span class="plug-option-label">${p.label}</span>
            <span class="plug-option-sublabel">${p.code || ''}</span>
          </button>`
        ).join('');

        return `
          <article class="product-card reveal" id="${item.id}">
            ${item.image ? `<div class="product-media"><img src="${item.image}" alt="${item.name}" loading="lazy" decoding="async"></div>` : ''}
            <div class="card-head">
              <div class="meta"><span>${item.brand}</span><span>${item.tier.replace('-', ' ')}</span></div>
              <h2>${item.name}</h2>
              <p>${item.description}</p>
            </div>
            <div class="card-body">
              ${item.variants.map(variant => `
                <div class="variant-row ${variant.id === current.id ? 'active' : ''}">
                  <button type="button" data-select="${item.id}" data-variant="${variant.id}">
                    <strong>${variant.label}</strong>
                    <span>${variant.sku}</span>
                  </button>
                  <div class="price">$${(variant.price_cents / 100).toFixed(2)}${variant.compare_at_cents && variant.compare_at_cents !== variant.price_cents ? `<span class="compare">$${(variant.compare_at_cents / 100).toFixed(2)}</span>` : ''}</div>
                </div>
              `).join('')}
              <div class="plug-section" style="margin-top:12px;">
                <div class="plug-section-title">Plug Type <span class="plug-required">*</span></div>
                <p class="plug-helper ${needsPlug ? 'error' : ''}">${needsPlug ? 'Choose a plug type before adding to cart.' : 'Choose the wall plug for the destination country.'}</p>
                <div class="plug-selector plug-selector-inline">${plugHtml}</div>
              </div>
              <div class="card-foot">
                <span class="sku">Selected: ${current.sku}</span>
                <span class="card-actions">
                  <a class="secondary-button" href="/products/${item.id}/" style="padding:0 12px;font-size:12px;">Details</a>
                  <button class="primary-button" type="button" data-add="${current.id}" style="padding:0 12px;font-size:12px;">Add to Cart</button>
                </span>
              </div>
            </div>
          </article>`;
      }).join('');

      initReveal();
    }

    function initReveal() {
      const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) entry.target.classList.add('visible');
        });
      }, { threshold: 0.12 });

      document.querySelectorAll('.reveal:not(.visible)').forEach(el => observer.observe(el));
    }

    function renderFilters() {
      const brands = [...new Set(catalogData.map(item => item.brand))].sort();
      const categoryLabels: Record<string, string> = {
        'tv-box': 'TV Boxes', premium: 'Premium', projector: 'Projectors'
      };
      const categories = ['tv-box', 'premium', 'projector']
        .filter(cat => catalogData.some(item => item.category === cat))
        .map(cat => [`category:${cat}`, categoryLabels[cat] || cat]);
      const tiers = [
        ['budget', 'Budget'], ['best-value', 'Best Value'], ['main', 'Main'],
        ['performance', 'Performance'], ['flagship', 'Flagship']
      ].filter(([tier]) => catalogData.some(item => item.tier === tier));
      const filters = [['all', 'All'], ...categories, ...brands.map(b => [`brand:${b}`, b]), ...tiers.map(([id, label]) => [`tier:${id}`, label])];

      document.getElementById('filters')!.innerHTML = filters.map(([id, label]) =>
        `<button class="filter ${id === activeFilter ? 'active' : ''}" type="button" data-filter="${id}">${label}</button>`
      ).join('');
    }

    function renderCart() {
      cart = cart.filter(item => variantById(item.id) && isValidPlug(item.plug));
      saveCart();

      const count = cart.reduce((sum, item) => sum + item.qty, 0);
      const subtotal = cart.reduce((sum, item) => sum + variantById(item.id)!.price_cents * item.qty, 0);
      const shipping = subtotal > 0 ? SHIPPING_CENTS : 0;
      const phase4 = (window as any).CRTLU_PHASE4;
      const formatMoney = phase4?.formatMoney || ((cents: number) => '$' + (cents / 100).toFixed(2));

      document.getElementById('cartCount')!.textContent = String(count);
      document.getElementById('cartSubtotal')!.textContent = formatMoney(subtotal);
      document.getElementById('cartShipping')!.textContent = subtotal > 0 ? formatMoney(shipping) : formatMoney(0);
      document.getElementById('cartTotal')!.textContent = formatMoney(subtotal + shipping);
      if (phase4?.renderAdjustments) phase4.renderAdjustments(subtotal, shipping);
      document.getElementById('checkoutButton').disabled = count === 0;

      document.getElementById('cartItems')!.innerHTML = cart.length
        ? cart.map((item, index) => {
            const variant = variantById(item.id);
            if (!variant) return '';
            return `
              <div class="cart-item">
                <div>
                  <h3>${variant.seriesName}</h3>
                  <p>${variant.label} / ${variant.sku}<br><strong class="cart-plug">${plugLabel(item.plug)}</strong></p>
                  <div class="quantity">
                    <button class="qty-btn" type="button" data-cart-index="${index}" data-change="-1">-</button>
                    <span>${item.qty}</span>
                    <button class="qty-btn" type="button" data-cart-index="${index}" data-change="1">+</button>
                  </div>
                  <button class="remove" type="button" data-remove-index="${index}">Remove</button>
                </div>
                <strong class="cart-price">$${(variant.price_cents * item.qty / 100).toFixed(2)}</strong>
              </div>`;
        }).join('')
        : '<div class="empty">Your cart is empty.</div>';

      // Cart item actions
      document.querySelectorAll('[data-cart-index]').forEach(btn => {
        btn.addEventListener('click', () => {
          const index = parseInt(btn.getAttribute('data-cart-index')!, 10);
          const change = parseInt(btn.getAttribute('data-change')!);
          const item = cart[index];
          if (item) {
            item.qty = Math.max(1, item.qty + change);
            saveCart();
            renderCart();
          }
        });
      });

      document.querySelectorAll('[data-remove-index]').forEach(btn => {
        btn.addEventListener('click', () => {
          const index = parseInt(btn.getAttribute('data-remove-index')!, 10);
          cart = cart.filter((_, itemIndex) => itemIndex !== index);
          saveCart();
          renderCart();
        });
      });
    }

    function openCart() {
      document.body.style.overflow = 'hidden';
      document.getElementById('cartDrawer')!.classList.add('open');
      document.getElementById('cartDrawer').setAttribute('aria-hidden', 'false');
      document.getElementById('cartBackdrop')!.classList.add('open');
    }

    function closeCart() {
      document.body.style.overflow = '';
      document.getElementById('cartDrawer')!.classList.remove('open');
      document.getElementById('cartDrawer').setAttribute('aria-hidden', 'true');
      document.getElementById('cartBackdrop')!.classList.remove('open');
    }

    function addToCart(id: string, seriesId?: string) {
      const plug = seriesId && selectedPlugs[seriesId] ? selectedPlugs[seriesId] : '';
      if (!plug) {
        if (seriesId) {
          plugWarnings[seriesId] = true;
          renderProducts();
          document.getElementById(seriesId)?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        return;
      }
      const existing = cart.find(item => item.id === id && item.plug === plug);
      if (existing) existing.qty += 1;
      else cart.push({ id, qty: 1, plug });
      saveCart();
      renderCart();
      openCart();
    }

    function initPhase4Controls() {
      const phase4 = (window as any).CRTLU_PHASE4;
      if (phase4ControlsReady || !phase4?.initControls) return;
      phase4ControlsReady = true;
      phase4.initControls({
        validateUrl: apiUrl('/api/validate-coupon.php'),
        getItems: () => cart,
        onChange: renderCart,
      });
      renderCart();
    }

    // Checkout
    async function checkout() {
      const status = document.getElementById('checkoutStatus');
      status.className = 'status';
      status.textContent = 'Creating checkout session...';
      const phase4 = (window as any).CRTLU_PHASE4;
      const checkoutMeta = phase4?.checkoutMeta ? phase4.checkoutMeta() : {};
      if (!cart.every(item => isValidPlug(item.plug))) {
        status.className = 'status error';
        status.textContent = 'Please choose a power adapter plug type for every item.';
        return;
      }

      try {
        const response = await fetch(apiUrl('/api/create-checkout-session.php'), {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: cart, ...checkoutMeta }),
        });
        const payload = phase4?.readJsonResponse
          ? await phase4.readJsonResponse(response, 'Checkout API returned an empty response.')
          : await response.json();
        if (!response.ok || !payload.url) throw new Error(payload.error || 'Checkout not configured');
        window.location.href = payload.url;
      } catch (error) {
        status.className = 'status error';
        status.textContent = error instanceof Error ? error.message : 'Something went wrong';
      }
    }

    // ---- Init ----
    function init() {
      variants = flattenVariants(catalogData);
      renderFilters();
      renderProducts();
      renderCart();
      initReveal();

      // Event delegation: filters
      document.getElementById('filters')!.addEventListener('click', event => {
        const filter = (event.target as HTMLElement).closest('[data-filter]');
        if (filter) {
          activeFilter = filter.dataset.filter!;
          renderFilters();
          renderProducts();
        }
      });

      // Search
      const searchInput = document.getElementById('catalogSearch') as HTMLInputElement;
      searchInput.addEventListener('input', event => {
        searchQuery = event.target.value;
        renderProducts();
      });

      document.getElementById('clearSearch')!.addEventListener('click', () => {
        searchQuery = '';
        searchInput.value = '';
        searchInput.focus();
        renderProducts();
      });

      // Sort
      document.getElementById('catalogSort')!.addEventListener('change', event => {
        sortMode = (event.target as HTMLSelectElement).value;
        renderProducts();
      });

      // Product grid actions (select variant / plug type / add to cart)
      document.getElementById('productGrid')!.addEventListener('click', event => {
        const select = (event.target as HTMLElement).closest('[data-select]');
        if (select) {
          selected[select.dataset.select!] = select.dataset.variant!;
          renderProducts();
        }

        const plug = (event.target as HTMLElement).closest('[data-plug]');
        if (plug) {
          const [seriesId, plugId] = plug.dataset.plug!.split(':');
          selectedPlugs[seriesId] = plugId;
          plugWarnings[seriesId] = false;
          renderProducts();
        }

        const add = (event.target as HTMLElement).closest('[data-add]');
        if (add) {
          const article = (add as HTMLElement).closest('article');
          const seriesId = article?.id;
          addToCart(add.dataset.add!, seriesId || undefined);
        }
      });

      // Cart drawer
      document.getElementById('openCart')!.addEventListener('click', openCart);
      document.getElementById('closeCart')!.addEventListener('click', closeCart);
      document.getElementById('cartBackdrop')!.addEventListener('click', closeCart);

      // Checkout
      document.getElementById('checkoutButton')!.addEventListener('click', checkout);

      initPhase4Controls();
      window.addEventListener('crtlu:phase4-ready', initPhase4Controls);

      // Mobile nav
      const mobileCartBtn = document.getElementById('mobileOpenCart');
      if (mobileCartBtn) mobileCartBtn.addEventListener('click', openCart);
    }

    init();
  </script>

  <script is:inline>
    window.setTimeout(() => {
      const summary = document.getElementById('summary');
      const grid = document.getElementById('productGrid');
      const filters = document.getElementById('filters');
      const catalog = Array.isArray(window.__CATALOG__) ? window.__CATALOG__ : [];

      if (!summary || !grid || !summary.textContent.includes('Loading catalog')) return;

      const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;',
      })[char]);
      const minPrice = (item) => Math.min(...(item.variants || []).map((variant) => Number(variant.price_cents) || 0));
      const variantCount = catalog.reduce((sum, item) => sum + ((item.variants || []).length), 0);

      summary.innerHTML = `<strong>${catalog.length}</strong> models / <strong>${variantCount}</strong> configs`;

      if (filters) {
        filters.innerHTML = [
          ['all', 'All'],
          ['category:tv-box', 'TV Boxes'],
          ['category:projector', 'Projectors'],
        ].map(([id, label]) => `<button class="filter ${id === 'all' ? 'active' : ''}" type="button" data-fallback-filter="${id}">${label}</button>`).join('');
      }

      const renderFallbackProducts = (items) => {
        grid.innerHTML = items.map((item) => {
          const firstVariant = (item.variants || [])[0];
          const price = minPrice(item);
          const compare = firstVariant && firstVariant.compare_at_cents && firstVariant.compare_at_cents !== firstVariant.price_cents
            ? `<span class="compare">$${(firstVariant.compare_at_cents / 100).toFixed(2)}</span>`
            : '';

          return `
            <article class="product-card reveal visible" id="${escapeHtml(item.id)}">
              ${item.image ? `<div class="product-media"><img src="${escapeHtml(item.image)}" alt="${escapeHtml(item.name)}" loading="lazy" decoding="async"></div>` : ''}
              <div class="card-head">
                <div class="meta"><span>${escapeHtml(item.brand)}</span><span>${escapeHtml(item.tier || item.category)}</span></div>
                <h2>${escapeHtml(item.name)}</h2>
                <p>${escapeHtml(item.description)}</p>
              </div>
              <div class="card-body">
                ${(item.variants || []).slice(0, 4).map((variant, index) => `
                  <div class="variant-row ${index === 0 ? 'active' : ''}">
                    <button type="button">
                      <strong>${escapeHtml(variant.label)}</strong>
                      <span>${escapeHtml(variant.sku)}</span>
                    </button>
                    <div class="price">$${((variant.price_cents || 0) / 100).toFixed(2)}${variant.compare_at_cents && variant.compare_at_cents !== variant.price_cents ? `<span class="compare">$${(variant.compare_at_cents / 100).toFixed(2)}</span>` : ''}</div>
                  </div>
                `).join('')}
                <div class="card-foot">
                  <span class="sku">${firstVariant ? `From ${escapeHtml(firstVariant.sku)}` : 'View model details'}</span>
                  <span class="card-actions">
                    <span class="price">$${(price / 100).toFixed(2)}${compare}</span>
                    <a class="secondary-button" href="/products/${encodeURIComponent(item.id)}/" style="padding:0 12px;font-size:12px;">Details</a>
                  </span>
                </div>
              </div>
            </article>`;
        }).join('');
      };

      renderFallbackProducts(catalog);

      if (filters) {
        filters.addEventListener('click', (event) => {
          const button = event.target.closest('[data-fallback-filter]');
          if (!button) return;
          const filter = button.dataset.fallbackFilter;
          const filtered = filter === 'all' ? catalog : catalog.filter((item) => `category:${item.category}` === filter);
          filters.querySelectorAll('[data-fallback-filter]').forEach((item) => item.classList.toggle('active', item === button));
          summary.innerHTML = `<strong>${filtered.length}</strong> models / fallback catalog render`;
          renderFallbackProducts(filtered);
        });
      }
    }, 1000);
  </script>
</Layout>
