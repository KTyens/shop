---
import { loadCatalog, loadPlugTypes } from '../../lib/catalog-data';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import CartDrawer from '../../components/CartDrawer.astro';
import PlugSelectorStyles from '../../components/PlugSelectorStyles.astro';
import '../../styles/global.css';
import {
  BRAND_DISCOVERY_KEYWORDS,
  CORE_SEO_KEYWORDS,
  SAFE_COMMERCE_KEYWORDS,
  itemListJsonLd,
} from '../../lib/seo';

const series = loadCatalog();
const plugTypes = loadPlugTypes();

const catalogPayload = series;
const plugTypesPayload = plugTypes;
const catalogKeywords = [
  ...CORE_SEO_KEYWORDS,
  ...BRAND_DISCOVERY_KEYWORDS,
  ...SAFE_COMMERCE_KEYWORDS,
  ...series.map((item) => item.name),
  ...series.map((item) => item.brand),
  'compare Android TV boxes',
  'Android TV box catalog',
  '4K set-top box',
  'streaming box for home cinema',
  'MECOOL TV box catalog',
  'X96 X98 TV box',
  'wireless HDMI catalog',
  'mini keyboard for Android TV box',
];
const catalogItemList = itemListJsonLd(
  'CRTLU Digital catalog — Android TV boxes, projectors, wireless HDMI, accessories',
  series
);
---

<Layout
  title="All Android TV Boxes, Projectors, Wireless HDMI & Accessories | CRTLU Digital"
  description="Browse the full CRTLU catalog: H96, HK1, MECOOL, X96/X98 TV boxes, projectors, wireless HDMI kits, and mini keyboards. Filter by brand, tier, and price. Stripe checkout + Yanwen shipping."
  keywords={catalogKeywords}
  canonicalPath="/products/"
  image="/assets/hero-cinema.jpg"
  jsonLd={catalogItemList}
>
  <Navigation />
  <CartDrawer />
  <PlugSelectorStyles />

  <main id="main-content">
    <section class="hero wrap">
      <div class="eyebrow" data-i18n="catalog.page.eyebrow">Complete catalog</div>
      <h1 data-i18n="catalog.page.title">All models. Clear specs. Ready to checkout.</h1>
      <p class="lead" data-i18n="catalog.page.lead">Browse every published Android TV box and compact projector by brand, tier, configuration, and price. Choose memory options and power-plug type before Stripe checkout.</p>

      <div class="catalog-console" aria-label="Catalog controls">
        <div class="catalog-controls">
          <label class="search-field">
            <span class="sr-only">Search catalog</span>
            <input type="search" id="catalogSearch" placeholder="Search model, brand, SKU, chipset..." data-i18n-placeholder="catalog.page.search" />
            <button class="clear-search" type="button" id="clearSearch" aria-label="Clear search">×</button>
          </label>
          <label class="sort-field">
            <span class="sr-only">Sort catalog</span>
            <select id="catalogSort" aria-label="Sort catalog">
              <option value="featured" data-i18n="catalog.page.sortFeatured">Featured order</option>
              <option value="price-asc" data-i18n="catalog.page.sortPriceAsc">Price: low to high</option>
              <option value="price-desc" data-i18n="catalog.page.sortPriceDesc">Price: high to low</option>
              <option value="name-asc" data-i18n="catalog.page.sortName">Name: A to Z</option>
            </select>
          </label>
        </div>
        <div class="toolbar" id="filters"></div>
        <div class="summary" id="summary" data-i18n="catalog.page.loading">Loading catalog...</div>
      </div>

      <!-- Category intro video: shown when Type = TV Boxes -->
      <div class="catalog-cat-video" id="catalogCatVideo" hidden>
        <div class="catalog-cat-video-frame">
          <video
            id="catalogCatVideoEl"
            src="/assets/videos/category-tv-box.mp4"
            poster="/assets/videos/category-tv-box-poster.jpg"
            muted
            playsinline
            webkit-playsinline
            loop
            controls
            preload="auto"
            disablepictureinpicture
          ></video>
        </div>
        <div class="catalog-cat-video-meta">
          <strong data-i18n="catalog.page.videoTvTitle">TV Box series overview</strong>
          <span data-i18n="catalog.page.videoTvLead">Short look at the Android TV box lineup — specs and packing style vary by model.</span>
        </div>
      </div>
    </section>

    <section class="wrap">
      <div class="product-grid" id="productGrid"></div>
    </section>
  </main>

  <!-- Inject catalog data as a global variable -->
  <script define:vars={{ catalogPayload, plugTypesPayload }}>
    window.__CATALOG__ = catalogPayload;
    window.__PLUG_TYPES__ = plugTypesPayload;
  </script>

  <script>
    // ---- Client-side interactivity ----

    const catalogData = Array.isArray(window.__CATALOG__) ? window.__CATALOG__ : [];
    const PLUG_TYPES = (Array.isArray(window.__PLUG_TYPES__) && window.__PLUG_TYPES__.length ? window.__PLUG_TYPES__ : [
      { id: 'uk', label: 'UK Plug', code: 'BS 1363' },
      { id: 'eu', label: 'EU Plug', code: 'Europlug' },
      { id: 'us', label: 'US Plug', code: 'NEMA 1-15' },
    ]);

    /** i18n helper — must exist before renderFilters/renderProducts (crash here falls back to legacy chips). */
    function t(key: string, vars?: Record<string, string>) {
      if ((window as any).CRTLU_I18N?.t) return (window as any).CRTLU_I18N.t(key, vars);
      const fallbacks: Record<string, string> = {
        'catalog.page.filterAll': 'All',
        'catalog.page.filterTv': 'TV Boxes',
        'catalog.page.filterProj': 'Projectors',
        'catalog.page.filterWirelessHdmi': 'Wireless HDMI',
        'catalog.page.filterAccessory': 'Accessories',
        'catalog.page.groupType': 'Type',
        'catalog.page.groupBrand': 'Brand',
        'catalog.page.groupTier': 'Tier',
        'catalog.page.lines': '{n} product lines',
        'catalog.page.configs': '{n} configurations',
        'catalog.page.noMatch': 'No matching products.',
        'catalog.page.search': 'Search model, brand, SKU, chipset...',
        'catalog.page.sortFeatured': 'Featured order',
        'catalog.page.sortPriceAsc': 'Price: low to high',
        'catalog.page.sortPriceDesc': 'Price: high to low',
        'catalog.page.sortName': 'Name: A to Z',
        'catalog.page.configLabel': 'Configuration',
        'home.compare.budget': 'Budget',
        'home.compare.performance': 'Performance',
        'home.compare.flagship': 'Flagship',
        'pdp.plugTitle': 'Power plug',
        'pdp.plugHelp': 'Select a plug type for your region.',
        'pdp.addToCart': 'Add to cart',
        'product.selected': 'Selected',
        'product.details': 'Details',
      };
      let out = fallbacks[key] || key;
      if (vars) {
        for (const [k, v] of Object.entries(vars)) {
          out = out.replace(new RegExp(`\\{${k}\\}`, 'g'), String(v));
        }
      }
      return out;
    }

    const SHIPPING_CENTS = 1200;
    const cartKey = 'crtlu-cart-v1';

    interface Variant {
      id: string;
      label: string;
      sku: string;
      price_cents: number;
      compare_at_cents?: number;
      seriesId?: string;
      seriesName?: string;
      brand?: string;
      tier?: string;
      category?: string;
      description?: string;
      image?: string;
    }

    interface PlugType {
      id: string;
      label: string;
      code?: string;
    }

    interface SeriesItem {
      id: string;
      name: string;
      brand: string;
      tier: string;
      category: string;
      description: string;
      image: string;
      variants: Variant[];
      specs?: Record<string, string>;
      detail_url?: string;
    }

    const initialParams = new URLSearchParams(window.location.search);
    const requestedCategory = initialParams.get('category');
    const knownCategories = new Set(
      catalogData.map((item: SeriesItem) => item.category).filter(Boolean) as string[]
    );
    let variants: Variant[] = [];
    let activeFilter =
      requestedCategory && knownCategories.has(requestedCategory)
        ? `category:${requestedCategory}`
        : 'all';
    let searchQuery = '';
    let sortMode = 'featured';
    let selected: Record<string, string> = {};
    let selectedPlugs: Record<string, string> = {};
    let plugWarnings: Record<string, boolean> = {};
    let cart: Array<{ id: string; qty: number; plug?: string }> = loadCart();
    let phase4ControlsReady = false;

    function flattenVariants(series: SeriesItem[]) {
      return series.flatMap(item =>
        (Array.isArray(item.variants) ? item.variants : []).map(variant => ({
          ...variant,
          seriesId: item.id,
          seriesName: item.name,
          brand: item.brand,
          tier: item.tier,
          category: item.category,
          description: item.description,
          image: item.image,
        }))
      );
    }

    function variantById(id: string) {
      return variants.find(v => v.id === id);
    }

    function plugById(id?: string): PlugType | undefined {
      return PLUG_TYPES.find((plug: PlugType) => plug.id === id);
    }

    function plugLabel(id?: string): string {
      const plug = plugById(id);
      return plug ? `${plug.label}${plug.code ? ` (${plug.code})` : ''}` : '';
    }

    function isValidPlug(id?: string): boolean {
      return Boolean(plugById(id));
    }

    function loadCart() {
      try {
        const parsed = JSON.parse(localStorage.getItem(cartKey) || '[]');
        return Array.isArray(parsed) ? parsed : [];
      } catch {
        return [];
      }
    }

    function saveCart() {
      localStorage.setItem(cartKey, JSON.stringify(cart));
    }

    function apiUrl(path: string) {
      return (window as any).crtluApiUrl ? (window as any).crtluApiUrl(path) : path;
    }

    function minPrice(item: SeriesItem) {
      const prices = (item.variants || []).map(v => Number(v.price_cents) || 0);
      return prices.length ? Math.min(...prices) : 0;
    }

    /** Friendly labels for product types (auto-extends for new categories). */
    function categoryLabel(cat: string): string {
      const map: Record<string, string> = {
        'tv-box': t('catalog.page.filterTv'),
        projector: t('catalog.page.filterProj'),
        'wireless-hdmi': t('catalog.page.filterWirelessHdmi'),
        accessory: t('catalog.page.filterAccessory'),
        premium: 'Premium',
      };
      if (map[cat]) return map[cat];
      // Fallback: humanize unknown category keys (e.g. smart-speaker → Smart Speaker)
      return cat
        .split(/[-_]/)
        .filter(Boolean)
        .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
        .join(' ');
    }

    function brandLabel(brand: string): string {
      // Keep brand as stored (MECOOL, HK1, H96…); normalize common casing
      const known: Record<string, string> = {
        mecool: 'MECOOL',
        h96: 'H96',
        hk1: 'HK1',
        ys: 'YS',
      };
      const key = brand.toLowerCase();
      return known[key] || brand;
    }

    function tierLabel(tier: string): string {
      const key = String(tier || '');
      const tierMap: Record<string, string> = {
        budget: t('home.compare.budget'),
        'best-value': 'Best Value',
        main: 'Main',
        performance: t('home.compare.performance'),
        flagship: t('home.compare.flagship'),
      };
      return tierMap[key] || key.replace(/-/g, ' ') || '—';
    }

    function filterLabel(filterId: string): string {
      if (filterId === 'all') return t('catalog.page.filterAll');
      if (filterId.startsWith('category:')) return categoryLabel(filterId.slice(9));
      if (filterId.startsWith('brand:')) return brandLabel(filterId.slice(6));
      if (filterId.startsWith('tier:')) return tierLabel(filterId.slice(5));
      return filterId;
    }

    function searchableText(item: SeriesItem) {
      const variants = Array.isArray(item.variants) ? item.variants : [];
      return [
        item.id, item.name, item.brand, item.category, item.tier, item.description,
        ...(item.specs ? Object.values(item.specs) : []),
        ...variants.flatMap(v => [v.id, v.label, v.sku, String(v.price_cents)]),
      ].filter(Boolean).join(' ').toLowerCase();
    }

    function filteredCatalog() {
      const query = searchQuery.trim().toLowerCase();
      const queryTokens = query.split(/\s+/).filter(Boolean);
      let items = catalogData;

      if (activeFilter.startsWith('category:'))
        items = items.filter(item => item.category === activeFilter.slice(9));
      else if (activeFilter.startsWith('brand:')) {
        const brandKey = activeFilter.slice(6).toLowerCase();
        items = items.filter(item => String(item.brand || '').toLowerCase() === brandKey);
      } else if (activeFilter.startsWith('tier:'))
        items = items.filter(item => item.tier === activeFilter.slice(5));

      if (queryTokens.length)
        items = items.filter(item => queryTokens.every(token => searchableText(item).includes(token)));

      const sorted = [...items];
      if (sortMode === 'price-asc') sorted.sort((a, b) => minPrice(a) - minPrice(b) || a.name.localeCompare(b.name));
      if (sortMode === 'price-desc') sorted.sort((a, b) => minPrice(b) - minPrice(a) || a.name.localeCompare(b.name));
      if (sortMode === 'name-asc') sorted.sort((a, b) => a.name.localeCompare(b.name));

      return sorted;
    }

    /** Show category intro video for TV Boxes (and future category videos). */
    function syncCategoryVideo() {
      const wrap = document.getElementById('catalogCatVideo') as HTMLElement | null;
      const video = document.getElementById('catalogCatVideoEl') as HTMLVideoElement | null;
      if (!wrap) return;
      const show = activeFilter === 'category:tv-box';
      wrap.hidden = !show;
      if (!video) return;

      const prime = () => {
        video.muted = true;
        video.defaultMuted = true;
        video.volume = 0;
        video.playsInline = true;
        video.setAttribute('playsinline', '');
        video.setAttribute('webkit-playsinline', '');
        video.setAttribute('muted', '');
      };

      const tryPlay = () => {
        prime();
        const p = video.play();
        if (p && typeof p.catch === 'function') p.catch(() => {});
      };

      if (show) {
        prime();
        // display:none → visible needs a fresh load + staggered retries
        if (video.readyState < 2) {
          try {
            video.load();
          } catch {
            /* ignore */
          }
        }
        tryPlay();
        requestAnimationFrame(() => tryPlay());
        [100, 300, 800, 1600].forEach((ms) => setTimeout(() => {
          if (video.paused && !wrap.hidden) tryPlay();
        }, ms));
        video.addEventListener('canplay', tryPlay, { once: true });
        video.addEventListener('loadeddata', tryPlay, { once: true });
      } else {
        video.pause();
      }
    }

    function renderProducts() {
      const items = filteredCatalog();
      const variantCount = items.reduce((sum, item) => sum + item.variants.length, 0);
      syncCategoryVideo();

      document.getElementById('summary')!.textContent =
        t('catalog.page.lines', { n: String(items.length) }) +
        ' · ' +
        t('catalog.page.configs', { n: String(variantCount) }) +
        ' · ' +
        filterLabel(activeFilter) +
        (searchQuery.trim() ? ` · "${searchQuery.trim()}"` : '');

      if (!items.length) {
        document.getElementById('productGrid')!.innerHTML = `
          <div class="empty-state">
            <div>
              <strong data-i18n="catalog.page.noMatch">${t('catalog.page.noMatch')}</strong>
            </div>
          </div>`;
        return;
      }

      document.getElementById('productGrid')!.innerHTML = items.map(item => {
        const itemVariants = Array.isArray(item.variants) ? item.variants : [];
        if (!itemVariants.length) return '';
        const selectedId = selected[item.id] || itemVariants[0].id;
        const selectedPlug = selectedPlugs[item.id] || '';
        const needsPlug = Boolean(plugWarnings[item.id]);
        const current = itemVariants.find(v => v.id === selectedId) || itemVariants[0];

        const plugHtml = PLUG_TYPES.map((p: PlugType) =>
          `<button class="plug-option ${p.id === selectedPlug ? 'active' : ''}" type="button" data-plug="${item.id}:${p.id}">
            <span class="plug-icon">
              <span class="plug-${p.id}-body">
                ${p.id === 'uk' ? '<span class="uk-pin"></span><span class="uk-pin-l"></span><span class="uk-pin-r"></span>' : ''}
                ${p.id === 'eu' ? '<span class="eu-pin"></span><span class="eu-pin"></span>' : ''}
                ${p.id === 'us' ? '<span class="us-pin"></span><span class="us-pin"></span><span class="us-ground"></span>' : ''}
              </span>
            </span>
            <span class="plug-option-label">${p.label}</span>
            <span class="plug-option-sublabel">${p.code || ''}</span>
          </button>`
        ).join('');

        const priceHtml = `$${(current.price_cents / 100).toFixed(2)}${
          current.compare_at_cents && current.compare_at_cents !== current.price_cents
            ? `<span class="compare">$${(current.compare_at_cents / 100).toFixed(2)}</span>`
            : ''
        }`;

        // Multi-config → dropdown; single config → compact static row (shorter cards)
        let configHtml = '';
        if (itemVariants.length > 1) {
          const options = itemVariants.map(variant =>
            `<option value="${variant.id}" ${variant.id === current.id ? 'selected' : ''}>${variant.label} — $${(variant.price_cents / 100).toFixed(2)}</option>`
          ).join('');
          configHtml = `
            <div class="config-picker">
              <label class="config-picker-label" for="cfg-${item.id}">${t('catalog.page.configLabel')}</label>
              <div class="config-picker-row">
                <select class="config-select" id="cfg-${item.id}" data-variant-select="${item.id}" aria-label="${t('catalog.page.configLabel')}">
                  ${options}
                </select>
                <div class="price config-price">${priceHtml}</div>
              </div>
            </div>`;
        } else {
          configHtml = `
            <div class="config-picker config-picker-single">
              <div class="config-picker-row">
                <div class="config-single-label">
                  <strong>${current.label}</strong>
                </div>
                <div class="price config-price">${priceHtml}</div>
              </div>
            </div>`;
        }

        return `
          <article class="product-card reveal" id="${item.id}">
            ${item.image ? `<a class="product-media-link" href="/products/${item.id}/" aria-label="View ${item.name}"><div class="product-media"><img src="${item.image}" alt="${item.name}" loading="lazy" decoding="async"></div></a>` : ''}
            <div class="card-head">
              <div class="meta"><span>${item.brand || ''}</span><span>${tierLabel(item.tier)}</span></div>
              <h2><a class="product-card-link" href="/products/${item.id}/">${item.name}</a></h2>
              <p>${item.description || ''}</p>
            </div>
            <div class="card-body">
              ${configHtml}
              <div class="plug-section" style="margin-top:12px;">
                <div class="plug-section-title">${t('pdp.plugTitle')} <span class="plug-required">*</span></div>
                <p class="plug-helper ${needsPlug ? 'error' : ''}">${t('pdp.plugHelp')}</p>
                <div class="plug-selector plug-selector-inline">${plugHtml}</div>
              </div>
              <div class="card-foot">
                <span class="sku">${t('product.selected')}: ${current.sku}</span>
                <span class="card-actions">
                  <a class="secondary-button" href="/products/${item.id}/" style="padding:0 12px;font-size:12px;">${t('product.details')}</a>
                  <button class="primary-button" type="button" data-add="${current.id}" style="padding:0 12px;font-size:12px;">${t('pdp.addToCart')}</button>
                </span>
              </div>
            </div>
          </article>`;
      }).join('');

      initReveal();
    }

    function initReveal() {
      const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) entry.target.classList.add('visible');
        });
      }, { threshold: 0.12 });

      document.querySelectorAll('.reveal:not(.visible)').forEach(el => observer.observe(el));
    }

    function renderFilters() {
      // Preferred type order; any new category from catalog is appended automatically.
      const preferredCatOrder = ['tv-box', 'projector', 'wireless-hdmi', 'accessory', 'premium'];
      const categories = [...new Set(catalogData.map((item) => item.category).filter(Boolean))] as string[];
      categories.sort((a, b) => {
        const ia = preferredCatOrder.indexOf(a);
        const ib = preferredCatOrder.indexOf(b);
        return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib) || a.localeCompare(b);
      });

      // Brands / series from catalog (MECOOL, H96, HK1, YS, …) — auto when new brands appear.
      const preferredBrandOrder = ['MECOOL', 'H96', 'HK1', 'Tanix', 'T95', 'TX', 'X5', 'HY', 'A10', 'YS'];
      const brands = [...new Set(catalogData.map((item) => item.brand).filter(Boolean))] as string[];
      brands.sort((a, b) => {
        const ia = preferredBrandOrder.findIndex((x) => x.toLowerCase() === a.toLowerCase());
        const ib = preferredBrandOrder.findIndex((x) => x.toLowerCase() === b.toLowerCase());
        return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib) || a.localeCompare(b, undefined, { sensitivity: 'base' });
      });

      const preferredTier = ['budget', 'best-value', 'main', 'performance', 'flagship'];
      const tiers = [...new Set(catalogData.map((item) => item.tier).filter(Boolean))] as string[];
      tiers.sort((a, b) => {
        const ia = preferredTier.indexOf(a);
        const ib = preferredTier.indexOf(b);
        return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib) || a.localeCompare(b);
      });

      const chip = (id: string, label: string) =>
        `<button class="filter ${id === activeFilter ? 'active' : ''}" type="button" data-filter="${id}">${label}</button>`;

      const typeChips = categories.map((cat) => chip(`category:${cat}`, categoryLabel(cat))).join('');
      const brandChips = brands.map((b) => chip(`brand:${b}`, brandLabel(b))).join('');
      const tierChips = tiers.map((tier) => chip(`tier:${tier}`, tierLabel(tier))).join('');

      document.getElementById('filters')!.innerHTML = `
        <div class="filter-row">
          ${chip('all', t('catalog.page.filterAll'))}
        </div>
        ${typeChips ? `<div class="filter-row"><span class="filter-group-label" data-i18n="catalog.page.groupType">${t('catalog.page.groupType')}</span>${typeChips}</div>` : ''}
        ${brandChips ? `<div class="filter-row"><span class="filter-group-label" data-i18n="catalog.page.groupBrand">${t('catalog.page.groupBrand')}</span>${brandChips}</div>` : ''}
        ${tierChips ? `<div class="filter-row"><span class="filter-group-label" data-i18n="catalog.page.groupTier">${t('catalog.page.groupTier')}</span>${tierChips}</div>` : ''}
      `;
    }

    function renderCart() {
      cart = cart.filter(item => variantById(item.id) && isValidPlug(item.plug));
      saveCart();

      const count = cart.reduce((sum, item) => sum + item.qty, 0);
      const subtotal = cart.reduce((sum, item) => sum + variantById(item.id)!.price_cents * item.qty, 0);
      const shipping = subtotal > 0 ? SHIPPING_CENTS : 0;
      const phase4 = (window as any).CRTLU_PHASE4;
      const formatMoney = phase4?.formatMoney || ((cents: number) => '$' + (cents / 100).toFixed(2));

      document.getElementById('cartCount')!.textContent = String(count);
      document.getElementById('cartSubtotal')!.textContent = formatMoney(subtotal);
      document.getElementById('cartShipping')!.textContent = subtotal > 0 ? formatMoney(shipping) : formatMoney(0);
      document.getElementById('cartTotal')!.textContent = formatMoney(subtotal + shipping);
      if (phase4?.renderAdjustments) phase4.renderAdjustments(subtotal, shipping);
      document.getElementById('checkoutButton').disabled = count === 0;

      document.getElementById('cartItems')!.innerHTML = cart.length
        ? cart.map((item, index) => {
            const variant = variantById(item.id);
            if (!variant) return '';
            return `
              <div class="cart-item">
                <img class="cart-thumb" src="${variant.image || ''}" alt="${variant.seriesName}" loading="lazy" decoding="async">
                <div>
                  <h3>${variant.seriesName}</h3>
                  <p>${variant.label} / ${variant.sku}<br><strong class="cart-plug">${plugLabel(item.plug)}</strong></p>
                  <div class="quantity">
                    <button class="qty-btn" type="button" data-cart-index="${index}" data-change="-1">-</button>
                    <span>${item.qty}</span>
                    <button class="qty-btn" type="button" data-cart-index="${index}" data-change="1">+</button>
                  </div>
                  <button class="remove" type="button" data-remove-index="${index}">Remove</button>
                </div>
                <strong class="cart-price">$${(variant.price_cents * item.qty / 100).toFixed(2)}</strong>
              </div>`;
        }).join('')
        : '<div class="empty">Your cart is empty.</div>';

      // Cart item actions
      document.querySelectorAll('[data-cart-index]').forEach(btn => {
        btn.addEventListener('click', () => {
          const index = parseInt(btn.getAttribute('data-cart-index')!, 10);
          const change = parseInt(btn.getAttribute('data-change')!);
          const item = cart[index];
          if (item) {
            item.qty = Math.max(1, item.qty + change);
            saveCart();
            renderCart();
          }
        });
      });

      document.querySelectorAll('[data-remove-index]').forEach(btn => {
        btn.addEventListener('click', () => {
          const index = parseInt(btn.getAttribute('data-remove-index')!, 10);
          cart = cart.filter((_, itemIndex) => itemIndex !== index);
          saveCart();
          renderCart();
        });
      });
    }

    function openCart() {
      document.body.style.overflow = 'hidden';
      document.getElementById('cartDrawer')!.classList.add('open');
      document.getElementById('cartDrawer').setAttribute('aria-hidden', 'false');
      document.getElementById('cartBackdrop')!.classList.add('open');
    }

    function closeCart() {
      document.body.style.overflow = '';
      document.getElementById('cartDrawer')!.classList.remove('open');
      document.getElementById('cartDrawer').setAttribute('aria-hidden', 'true');
      document.getElementById('cartBackdrop')!.classList.remove('open');
    }

    function addToCart(id: string, seriesId?: string) {
      const plug = seriesId && selectedPlugs[seriesId] ? selectedPlugs[seriesId] : '';
      if (!plug) {
        if (seriesId) {
          plugWarnings[seriesId] = true;
          renderProducts();
          document.getElementById(seriesId)?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        return;
      }
      const existing = cart.find(item => item.id === id && item.plug === plug);
      if (existing) existing.qty += 1;
      else cart.push({ id, qty: 1, plug });
      saveCart();
      renderCart();
      openCart();
    }

    function initPhase4Controls() {
      const phase4 = (window as any).CRTLU_PHASE4;
      if (phase4ControlsReady || !phase4?.initControls) return;
      phase4ControlsReady = true;
      phase4.initControls({
        validateUrl: apiUrl('/api/validate-coupon.php'),
        getItems: () => cart,
        onChange: renderCart,
      });
      renderCart();
    }

    // Checkout
    async function checkout() {
      const status = document.getElementById('checkoutStatus');
      status.className = 'status';
      status.textContent = 'Creating checkout session...';
      const phase4 = (window as any).CRTLU_PHASE4;
      const checkoutMeta = phase4?.checkoutMeta ? phase4.checkoutMeta() : {};
      if (!cart.every(item => isValidPlug(item.plug))) {
        status.className = 'status error';
        status.textContent = 'Please choose a power adapter plug type for every item.';
        return;
      }

      try {
        const response = await fetch(apiUrl('/api/create-checkout-session.php'), {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: cart, ...checkoutMeta }),
        });
        const payload = phase4?.readJsonResponse
          ? await phase4.readJsonResponse(response, 'Checkout API returned an empty response.')
          : await response.json();
        if (!response.ok || !payload.url) throw new Error(payload.error || 'Checkout not configured');
        window.location.href = payload.url;
      } catch (error) {
        status.className = 'status error';
        status.textContent = error instanceof Error ? error.message : 'Something went wrong';
      }
    }

    // ---- Init ----
    function init() {
      variants = flattenVariants(catalogData);
      renderFilters();
      renderProducts();
      window.addEventListener('crtlu:localechange', () => {
        if (window.CRTLU_I18N?.apply) window.CRTLU_I18N.apply(document);
        // refresh sort option labels
        const sort = document.getElementById('catalogSort');
        if (sort) {
          const map = {
            featured: 'catalog.page.sortFeatured',
            'price-asc': 'catalog.page.sortPriceAsc',
            'price-desc': 'catalog.page.sortPriceDesc',
            'name-asc': 'catalog.page.sortName',
          };
          [...sort.options].forEach(opt => {
            const key = map[opt.value];
            if (key) opt.textContent = t(key);
          });
        }
        const search = document.getElementById('catalogSearch');
        if (search) search.setAttribute('placeholder', t('catalog.page.search'));
        renderFilters();
        renderProducts();
      });

      renderCart();
      initReveal();

      // Event delegation: filters
      document.getElementById('filters')!.addEventListener('click', event => {
        const filter = (event.target as HTMLElement).closest('[data-filter]');
        if (filter) {
          activeFilter = filter.dataset.filter!;
          renderFilters();
          renderProducts();
        }
      });

      // Search
      const searchInput = document.getElementById('catalogSearch') as HTMLInputElement;
      searchInput.addEventListener('input', event => {
        searchQuery = event.target.value;
        renderProducts();
      });

      document.getElementById('clearSearch')!.addEventListener('click', () => {
        searchQuery = '';
        searchInput.value = '';
        searchInput.focus();
        renderProducts();
      });

      // Sort
      document.getElementById('catalogSort')!.addEventListener('change', event => {
        sortMode = (event.target as HTMLSelectElement).value;
        renderProducts();
      });

      // Product grid: config dropdown change
      document.getElementById('productGrid')!.addEventListener('change', event => {
        const sel = (event.target as HTMLElement).closest('[data-variant-select]') as HTMLSelectElement | null;
        if (sel && sel.dataset.variantSelect) {
          selected[sel.dataset.variantSelect] = sel.value;
          renderProducts();
        }
      });

      // Product grid actions (plug type / add to cart)
      document.getElementById('productGrid')!.addEventListener('click', event => {
        const plug = (event.target as HTMLElement).closest('[data-plug]');
        if (plug) {
          const [seriesId, plugId] = plug.dataset.plug!.split(':');
          selectedPlugs[seriesId] = plugId;
          plugWarnings[seriesId] = false;
          renderProducts();
        }

        const add = (event.target as HTMLElement).closest('[data-add]');
        if (add) {
          const article = (add as HTMLElement).closest('article');
          const seriesId = article?.id;
          addToCart(add.dataset.add!, seriesId || undefined);
        }
      });

      // Cart drawer
      document.getElementById('openCart')!.addEventListener('click', openCart);
      document.getElementById('closeCart')!.addEventListener('click', closeCart);
      document.getElementById('cartBackdrop')!.addEventListener('click', closeCart);

      // Checkout
      document.getElementById('checkoutButton')!.addEventListener('click', checkout);

      initPhase4Controls();
      window.addEventListener('crtlu:phase4-ready', initPhase4Controls);

      // Mobile nav
      const mobileCartBtn = document.getElementById('mobileOpenCart');
      if (mobileCartBtn) mobileCartBtn.addEventListener('click', openCart);

      if (initialParams.get('cart') === 'open') openCart();
    }

    init();
  </script>

  <script is:inline>
    // Safety net: only runs if the main catalog script never left "Loading catalog..."
    // (e.g. JS error). Builds dynamic type/brand chips + search so new products stay findable.
    window.setTimeout(() => {
      const summary = document.getElementById('summary');
      const grid = document.getElementById('productGrid');
      const filters = document.getElementById('filters');
      const catalog = Array.isArray(window.__CATALOG__) ? window.__CATALOG__ : [];
      // Main script already painted the grid (or main filters with data-filter) — do nothing.
      if (!summary || !grid || grid.children.length > 0) return;
      if (filters && filters.querySelector('[data-filter]')) return;

      const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;',
      })[char]);

      const categoryLabel = (cat) => {
        const map = {
          'tv-box': 'TV Boxes',
          projector: 'Projectors',
          'wireless-hdmi': 'Wireless HDMI',
          accessory: 'Accessories',
          premium: 'Premium',
        };
        if (map[cat]) return map[cat];
        return String(cat || '')
          .split(/[-_]/)
          .filter(Boolean)
          .map((p) => p.charAt(0).toUpperCase() + p.slice(1))
          .join(' ') || 'Other';
      };

      const preferredCatOrder = ['tv-box', 'projector', 'wireless-hdmi', 'accessory', 'premium'];
      const preferredBrandOrder = ['MECOOL', 'H96', 'HK1', 'Tanix', 'T95', 'TX', 'X5', 'HY', 'A10', 'YS'];
      const categories = [...new Set(catalog.map((item) => item.category).filter(Boolean))].sort((a, b) => {
        const ia = preferredCatOrder.indexOf(a);
        const ib = preferredCatOrder.indexOf(b);
        return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib) || String(a).localeCompare(String(b));
      });
      const brands = [...new Set(catalog.map((item) => item.brand).filter(Boolean))].sort((a, b) => {
        const ia = preferredBrandOrder.findIndex((x) => x.toLowerCase() === String(a).toLowerCase());
        const ib = preferredBrandOrder.findIndex((x) => x.toLowerCase() === String(b).toLowerCase());
        return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib) || String(a).localeCompare(String(b), undefined, { sensitivity: 'base' });
      });

      let activeFilter = 'all';
      let searchQuery = '';

      const minPrice = (item) => {
        const prices = (item.variants || []).map((v) => Number(v.price_cents) || 0);
        return prices.length ? Math.min(...prices) : 0;
      };

      const searchableText = (item) => [
        item.id, item.name, item.brand, item.category, item.tier, item.description,
        ...Object.values(item.specs || {}),
        ...(item.variants || []).flatMap((v) => [v.id, v.label, v.sku, String(v.price_cents)]),
      ].filter(Boolean).join(' ').toLowerCase();

      const filteredItems = () => {
        let items = catalog;
        if (activeFilter.startsWith('category:')) {
          items = items.filter((item) => item.category === activeFilter.slice(9));
        } else if (activeFilter.startsWith('brand:')) {
          const key = activeFilter.slice(6).toLowerCase();
          items = items.filter((item) => String(item.brand || '').toLowerCase() === key);
        }
        const tokens = searchQuery.trim().toLowerCase().split(/\s+/).filter(Boolean);
        if (tokens.length) {
          items = items.filter((item) => tokens.every((token) => searchableText(item).includes(token)));
        }
        return items;
      };

      const chip = (id, label) =>
        `<button class="filter ${id === activeFilter ? 'active' : ''}" type="button" data-fallback-filter="${escapeHtml(id)}">${escapeHtml(label)}</button>`;

      const renderFallbackFilters = () => {
        if (!filters) return;
        const typeChips = categories.map((cat) => chip(`category:${cat}`, categoryLabel(cat))).join('');
        const brandChips = brands.map((b) => chip(`brand:${b}`, b)).join('');
        filters.innerHTML = `
          <div class="filter-row">${chip('all', 'All')}</div>
          ${typeChips ? `<div class="filter-row"><span class="filter-group-label">Type</span>${typeChips}</div>` : ''}
          ${brandChips ? `<div class="filter-row"><span class="filter-group-label">Brand</span>${brandChips}</div>` : ''}
        `;
      };

      const renderFallbackProducts = (items) => {
        const variantCount = items.reduce((sum, item) => sum + ((item.variants || []).length), 0);
        summary.innerHTML = `<strong>${items.length}</strong> models / <strong>${variantCount}</strong> configs`
          + (searchQuery.trim() ? ` · "${escapeHtml(searchQuery.trim())}"` : '');

        if (!items.length) {
          grid.innerHTML = `<div class="empty-state"><div><strong>No matching products.</strong></div></div>`;
          return;
        }

        grid.innerHTML = items.map((item) => {
          const firstVariant = (item.variants || [])[0];
          const price = minPrice(item);
          const compare = firstVariant && firstVariant.compare_at_cents && firstVariant.compare_at_cents !== firstVariant.price_cents
            ? `<span class="compare">$${(firstVariant.compare_at_cents / 100).toFixed(2)}</span>`
            : '';

          return `
            <article class="product-card reveal visible" id="${escapeHtml(item.id)}">
              ${item.image ? `<a class="product-media-link" href="/products/${encodeURIComponent(item.id)}/"><div class="product-media"><img src="${escapeHtml(item.image)}" alt="${escapeHtml(item.name)}" loading="lazy" decoding="async"></div></a>` : ''}
              <div class="card-head">
                <div class="meta"><span>${escapeHtml(item.brand)}</span><span>${escapeHtml(String(item.tier || item.category || '').replace(/-/g, ' '))}</span></div>
                <h2><a class="product-card-link" href="/products/${encodeURIComponent(item.id)}/">${escapeHtml(item.name)}</a></h2>
                <p>${escapeHtml(item.description)}</p>
              </div>
              <div class="card-body">
                ${(item.variants || []).slice(0, 4).map((variant, index) => `
                  <div class="variant-row ${index === 0 ? 'active' : ''}">
                    <button type="button">
                      <strong>${escapeHtml(variant.label)}</strong>
                      <span>${escapeHtml(variant.sku)}</span>
                    </button>
                    <div class="price">$${((variant.price_cents || 0) / 100).toFixed(2)}${variant.compare_at_cents && variant.compare_at_cents !== variant.price_cents ? `<span class="compare">$${(variant.compare_at_cents / 100).toFixed(2)}</span>` : ''}</div>
                  </div>
                `).join('')}
                <div class="card-foot">
                  <span class="sku">${firstVariant ? `From ${escapeHtml(firstVariant.sku)}` : 'View model details'}</span>
                  <span class="card-actions">
                    <span class="price">$${(price / 100).toFixed(2)}${compare}</span>
                    <a class="secondary-button" href="/products/${encodeURIComponent(item.id)}/" style="padding:0 12px;font-size:12px;">Details</a>
                  </span>
                </div>
              </div>
            </article>`;
        }).join('');
      };

      const refresh = () => {
        renderFallbackFilters();
        renderFallbackProducts(filteredItems());
      };

      refresh();

      if (filters) {
        filters.addEventListener('click', (event) => {
          const button = event.target.closest('[data-fallback-filter]');
          if (!button) return;
          activeFilter = button.dataset.fallbackFilter || 'all';
          refresh();
        });
      }

      const searchInput = document.getElementById('catalogSearch');
      if (searchInput && !searchInput.dataset.fallbackBound) {
        searchInput.dataset.fallbackBound = '1';
        searchInput.addEventListener('input', (event) => {
          searchQuery = event.target.value || '';
          renderFallbackProducts(filteredItems());
        });
      }
      const clearSearch = document.getElementById('clearSearch');
      if (clearSearch && !clearSearch.dataset.fallbackBound) {
        clearSearch.dataset.fallbackBound = '1';
        clearSearch.addEventListener('click', () => {
          searchQuery = '';
          if (searchInput) searchInput.value = '';
          renderFallbackProducts(filteredItems());
        });
      }
    }, 1000);
  </script>
</Layout>
