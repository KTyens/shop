---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import CartDrawer from '../components/CartDrawer.astro';
import '../styles/global.css';

const currencies = ['USD', 'JPY', 'CNY', 'EUR'];
const locales = [
  { code: 'en', label: 'English' },
  { code: 'ja', label: '日本語' },
  { code: 'zh-CN', label: '简体中文' },
  { code: 'zh-TW', label: '繁體中文' },
  { code: 'ar', label: 'العربية' },
  { code: 'es', label: 'Español' },
  { code: 'pt', label: 'Português' },
  { code: 'id', label: 'Bahasa Indonesia' },
  { code: 'th', label: 'ภาษาไทย' },
  { code: 'vi', label: 'Tiếng Việt' },
  { code: 'ms', label: 'Bahasa Melayu' },
];
---

<Layout title="Account | CRTLU Digital" description="Sign in to view orders, manage addresses, and keep checkout preferences." canonicalPath="/account/" robots="noindex, follow">
  <Navigation />
  <CartDrawer />

  <main id="main-content" style="padding:44px 0;">
    <div style="width:min(var(--max),calc(100% - 44px));margin:0 auto;">
      <h1 style="font-size:clamp(36px,7vw,72px);line-height:.92;margin:0 0 10px;letter-spacing:0;">Account</h1>
      <p id="accountLead" style="color:var(--muted);line-height:1.65;margin:0 0 22px;max-width:680px;">Sign in with your email to view orders, save delivery addresses, and keep checkout preferences ready for repeat purchases.</p>

      <!-- Signed-in identity chip (mainstream avatar style) -->
      <div class="account-user-chip" id="userChip" hidden>
        <div class="account-user-chip-avatar" id="userChipAvatar" aria-hidden="true">?</div>
        <div class="account-user-chip-meta">
          <span class="eyebrow" style="font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);">Signed in as</span>
          <strong id="signedInAs">Guest</strong>
        </div>
        <button class="secondary-button" type="button" id="logoutButton" style="color:var(--danger);margin-left:8px;">Sign out</button>
      </div>

      <!-- Login panel -->
      <div class="panel" id="loginPanel" style="border:1px solid var(--line);background:#fff;padding:28px;margin-bottom:22px;max-width:560px;">
        <h2 style="margin:0 0 8px;font-size:22px;">Email sign-in</h2>
        <p style="color:var(--muted);line-height:1.65;margin:0 0 18px;font-size:14px;">Use the same email you enter at Stripe Checkout. We will send a one-time 6-digit code.</p>

        <div class="account-login-row">
          <label>
            <span style="color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.05em;">Email</span>
            <input id="loginEmail" type="email" autocomplete="email" placeholder="you@example.com" />
          </label>
          <button class="primary-button" type="button" id="sendCode">Send code</button>
        </div>

        <div class="account-login-row" style="margin-top:12px;">
          <label>
            <span style="color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.05em;">6-digit code</span>
            <input id="loginCode" inputmode="numeric" maxlength="6" placeholder="123456" />
          </label>
          <button class="primary-button" type="button" id="verifyCode">Sign in</button>
        </div>

        <div class="message" id="loginMessage" style="min-height:22px;margin-top:10px;color:var(--green);font-size:14px;"></div>
      </div>

      <!-- Account panel (hidden until logged in) -->
      <div id="accountPanel" style="display:grid;grid-template-columns:1fr 1fr;gap:18px;" class="hidden">
        <!-- Profile -->
        <div class="panel" style="border:1px solid var(--line);background:rgba(255,255,255,.045);padding:28px;">
          <h2 style="margin:0 0 18px;font-size:22px;">Profile</h2>
          <div style="display:grid;grid-template-columns:1fr;gap:12px;">
            <label>
              <span style="color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.05em;">Name</span>
              <input id="profileName" autocomplete="name" placeholder="Your name" style="width:100%;min-height:42px;border:1px solid var(--line);background:rgba(0,0,0,.24);color:var(--text);padding:0 12px;font:inherit;" />
            </label>
            <label>
              <span style="color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.05em;">Language</span>
              <select id="profileLocale" style="width:100%;min-height:42px;border:1px solid var(--line);background:rgba(0,0,0,.24);color:var(--text);padding:0 12px;font:inherit;"></select>
            </label>
            <label>
              <span style="color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.05em;">Preferred currency</span>
              <select id="profileCurrency" style="width:100%;min-height:42px;border:1px solid var(--line);background:rgba(0,0,0,.24);color:var(--text);padding:0 12px;font:inherit;">
                {currencies.map((currency) => <option value={currency}>{currency}</option>)}
              </select>
            </label>
          </div>
          <button class="primary-button" type="button" id="saveProfile" style="margin-top:16px;">Save profile</button>
          <div class="message" id="profileMessage" style="min-height:22px;margin-top:10px;color:var(--green);font-size:14px;"></div>
        </div>

        <!-- Saved address form -->
        <div class="panel" style="border:1px solid var(--line);background:rgba(255,255,255,.045);padding:28px;">
          <h2 style="margin:0 0 18px;font-size:22px;">Saved address</h2>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <label><span style="color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.05em;">Label</span><input id="addrLabel" placeholder="Home" style="width:100%;min-height:42px;border:1px solid var(--line);background:rgba(0,0,0,.24);color:var(--text);padding:0 12px;font:inherit;" /></label>
            <label><span style="color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.05em;">Recipient</span><input id="addrName" autocomplete="name" style="width:100%;min-height:42px;border:1px solid var(--line);background:rgba(0,0,0,.24);color:var(--text);padding:0 12px;font:inherit;" /></label>
            <label><span style="color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.05em;">Phone</span><input id="addrPhone" autocomplete="tel" style="width:100%;min-height:42px;border:1px solid var(--line);background:rgba(0,0,0,.24);color:var(--text);padding:0 12px;font:inherit;" /></label>
            <label><span style="color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.05em;">Country</span><input id="addrCountry" placeholder="Japan" style="width:100%;min-height:42px;border:1px solid var(--line);background:rgba(0,0,0,.24);color:var(--text);padding:0 12px;font:inherit;" /></label>
            <label><span style="color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.05em;">Postal code</span><input id="addrPostal" style="width:100%;min-height:42px;border:1px solid var(--line);background:rgba(0,0,0,.24);color:var(--text);padding:0 12px;font:inherit;" /></label>
            <label><span style="color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.05em;">State</span><input id="addrState" style="width:100%;min-height:42px;border:1px solid var(--line);background:rgba(0,0,0,.24);color:var(--text);padding:0 12px;font:inherit;" /></label>
            <label><span style="color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.05em;">City</span><input id="addrCity" style="width:100%;min-height:42px;border:1px solid var(--line);background:rgba(0,0,0,.24);color:var(--text);padding:0 12px;font:inherit;" /></label>
            <label class="wide" style="grid-column:1/-1;"><span style="color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.05em;">Address line 1</span><input id="addrLine1" style="width:100%;min-height:42px;border:1px solid var(--line);background:rgba(0,0,0,.24);color:var(--text);padding:0 12px;font:inherit;" /></label>
            <label class="wide" style="grid-column:1/-1;"><span style="color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:.05em;">Address line 2</span><input id="addrLine2" style="width:100%;min-height:42px;border:1px solid var(--line);background:rgba(0,0,0,.24);color:var(--text);padding:0 12px;font:inherit;" /></label>
          </div>
          <button class="primary-button" type="button" id="saveAddress" style="margin-top:16px;">Save address</button>
          <div class="message" id="addressMessage" style="min-height:22px;margin-top:10px;color:var(--green);font-size:14px;"></div>
        </div>

        <!-- Addresses list -->
        <div class="panel full" style="grid-column:1/-1;border:1px solid var(--line);background:rgba(255,255,255,.045);padding:28px;">
          <h2 style="margin:0 0 18px;font-size:22px;">Addresses</h2>
          <div id="addressesList"></div>
        </div>

        <!-- Orders list -->
        <div class="panel full" id="orders" style="grid-column:1/-1;border:1px solid var(--line);background:rgba(255,255,255,.045);padding:28px;">
          <h2 style="margin:0 0 18px;font-size:22px;">Orders</h2>
          <div id="ordersList"></div>
        </div>
      </div>
    </div>
  </main>

  <style>
    .panel { display: none; }
    .panel:not(.hidden) { display: block; }
    .wide { grid-column: 1 / -1; }
    @media (max-width: 860px) {
      #accountPanel { grid-template-columns: 1fr !important; }
    }
  </style>

  <script>
    // Must live in client script (Astro frontmatter `locales` is not visible here).
    const locales = [
      { code: 'en', label: 'English' },
      { code: 'ja', label: '日本語' },
      { code: 'zh-CN', label: '简体中文' },
      { code: 'zh-TW', label: '繁體中文' },
      { code: 'ar', label: 'العربية' },
      { code: 'es', label: 'Español' },
      { code: 'pt', label: 'Português' },
      { code: 'id', label: 'Bahasa Indonesia' },
      { code: 'th', label: 'ภาษาไทย' },
      { code: 'vi', label: 'Tiếng Việt' },
      { code: 'ms', label: 'Bahasa Melayu' },
    ];

    const apiUrl = path => window.crtluApiUrl ? window.crtluApiUrl(path) : path;
    const api = {
      requestCode: apiUrl('/api/account-request-code.php'),
      login: apiUrl('/api/account-login.php'),
      account: apiUrl('/api/account.php'),
      logout: apiUrl('/api/account-logout.php'),
      track: apiUrl('/api/yanwen-track.php'),
    };

    let state = { authenticated: false, member: null, orders: [], addresses: [] };
    const $ = id => document.getElementById(id);

    function esc(value) {
      return String(value ?? '').replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[ch]));
    }

    function setMessage(id, text, error = false) {
      const el = $(id);
      el.textContent = text || '';
      el.className = error ? 'message error' : 'message';
      el.style.color = error ? 'var(--danger)' : 'var(--green)';
    }

    async function post(url, payload) {
      let response;
      try {
        response = await fetch(url, {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload || {}),
        });
      } catch {
        throw new Error(
          'Failed to reach the login server (network/CORS). If this persists, the account API may be blocked — try again or contact support.'
        );
      }
      const text = await response.text();
      let data = {};
      try {
        data = text ? JSON.parse(text) : {};
      } catch {
        throw new Error(text.slice(0, 180) || `Invalid response (${response.status}).`);
      }
      if (!response.ok || data.ok === false) {
        throw new Error(data.message || data.error || `Request failed (${response.status}).`);
      }
      return data;
    }

    async function loadAccount() {
      try {
        const response = await fetch(api.account, { credentials: 'include' });
        state = await response.json();
        render();
        if (state.message) setMessage('loginMessage', state.message, true);
      } catch {
        state = { authenticated: false, member: null, orders: [], addresses: [] };
        render();
      }
    }

    function memberInitial(member) {
      const name = String(member?.name || '').trim();
      if (name) return name.charAt(0).toUpperCase();
      const email = String(member?.email || '').trim();
      if (email) return email.charAt(0).toUpperCase();
      return '?';
    }

    function render() {
      const authed = !!state.authenticated;
      $('loginPanel').style.display = authed ? 'none' : 'block';
      $('accountPanel').style.display = authed ? 'grid' : 'none';
      const chip = $('userChip');
      if (chip) chip.hidden = !authed;
      const lead = $('accountLead');
      if (lead) lead.style.display = authed ? 'none' : 'block';

      if (authed && state.member) {
        $('signedInAs').textContent = state.member.email || 'Member';
        const av = $('userChipAvatar');
        if (av) av.textContent = memberInitial(state.member);
      } else {
        $('signedInAs').textContent = 'Guest';
      }

      if (typeof window.crtluRefreshAccountNav === 'function') {
        window.crtluRefreshAccountNav();
      }

      if (!authed) return;

      $('profileName').value = state.member.name || '';
      renderLanguageOptions();
      $('profileLocale').value = state.member.locale || 'en';
      $('profileCurrency').value = state.member.currency || 'USD';

      renderAddresses();
      renderOrders();
    }

    function renderLanguageOptions() {
      const select = $('profileLocale');
      select.innerHTML = locales.map(l => `<option value="${l.code}">${l.label}</option>`).join('');
    }

    function renderAddresses() {
      const list = state.addresses || [];
      $('addressesList').innerHTML = list.length
        ? list.map(addr => `
            <article style="border:1px solid var(--line);background:rgba(0,0,0,.18);padding:16px;margin-bottom:12px;">
              <div style="display:flex;justify-content:space-between;gap:12px;align-items:start;margin-bottom:10px;">
                <div>
                  <strong>${esc(addr.label || 'Address')}</strong>
                  ${addr.is_default ? '<span style="display:inline-flex;padding:4px 8px;color:var(--green);border:1px solid rgba(130,255,143,.36);background:rgba(130,255,143,.08);font-size:12px;text-transform:uppercase;font-weight:900;margin-left:8px;">Default</span>' : ''}
                </div>
                <button type="button" data-delete-address="${esc(addr.id)}" style="color:var(--danger);background:none;padding:0;border:none;cursor:pointer;font:inherit;font-size:12px;">Delete</button>
              </div>
              <div style="color:var(--muted);font-size:14px;">${esc(addr.recipient_name)} ${esc(addr.phone)}</div>
              <div style="font-size:14px;">${esc(addr.line1)} ${esc(addr.line2)}</div>
              <div style="color:var(--muted);font-size:14px;">${esc(addr.city)} ${esc(addr.state)} ${esc(addr.postal_code)} ${esc(addr.country)}</div>
            </article>`).join('')
        : '<div style="color:var(--muted);border:1px dashed var(--line);padding:16px;">No saved addresses.</div>';

      $('addressesList').querySelectorAll('[data-delete-address]').forEach(btn => {
        btn.addEventListener('click', async () => {
          setMessage('addressMessage', 'Deleting...');
          try {
            await post(api.account, { action: 'delete_address', id: btn.dataset.deleteAddress });
            await loadAccount();
            setMessage('addressMessage', 'Address deleted.');
          } catch (error) {
            setMessage('addressMessage', error.message, true);
          }
        });
      });
    }

    function renderOrders() {
      const orders = state.orders || [];
      const money = (cents, currency) => `${(currency || 'USD').toUpperCase()} ${(Number(cents || 0) / 100).toFixed(2)}`;

      $('ordersList').innerHTML = orders.length
        ? orders.map(order => `
            <article style="border:1px solid var(--line);background:rgba(0,0,0,.18);padding:16px;margin-bottom:12px;" data-order-id="${esc(order.id)}">
              <div style="display:flex;justify-content:space-between;gap:12px;align-items:start;margin-bottom:10px;">
                <div>
                  <strong>Order #${esc(order.id)}</strong>
                  <div style="color:var(--muted);font-size:13px;margin-top:2px;">${esc(order.created_at || '')}</div>
                </div>
                <span style="display:inline-flex;padding:4px 8px;color:var(--green);border:1px solid rgba(130,255,143,.36);background:rgba(130,255,143,.08);font-size:12px;text-transform:uppercase;font-weight:900;">${esc(order.status || 'paid')}</span>
              </div>
              <div style="font-size:14px;">Total: <strong>${esc(money(order.amount_total, order.currency))}</strong></div>
              ${order.coupon_code ? `<div style="color:var(--muted);font-size:14px;">Coupon ${esc(order.coupon_code)} saved ${esc(money(order.discount_total, order.currency))}</div>` : ''}
              ${order.yanwen_tracking
                ? `<div style="font-size:14px;margin-top:6px;">Tracking: <strong>${esc(order.yanwen_tracking)}</strong>
                    <button type="button" class="secondary-button" data-track-order="${esc(order.id)}" style="margin-left:10px;font-size:12px;padding:0 12px;min-height:32px;">View tracking</button>
                   </div>
                   <div class="track-panel" data-track-panel="${esc(order.id)}" hidden style="margin-top:12px;padding:12px;border:1px solid var(--line);background:rgba(0,0,0,.22);font-size:13px;line-height:1.55;"></div>`
                : `<div style="color:var(--muted);font-size:14px;">Tracking will be added after shipment</div>`}
              ${(order.items && order.items.length) ? `<ul style="margin:10px 0 0;padding-left:18px;color:#cbd8df;font-size:14px;">${order.items.map(item => `<li>${item.quantity} x ${esc(item.product_name)}</li>`).join('')}</ul>` : ''}
            </article>`).join('')
        : '<div style="color:var(--muted);border:1px dashed var(--line);padding:16px;">No orders yet.</div>';

      $('ordersList').querySelectorAll('[data-track-order]').forEach(btn => {
        btn.addEventListener('click', async () => {
          const orderId = btn.getAttribute('data-track-order');
          const panel = $('ordersList').querySelector(`[data-track-panel="${orderId}"]`);
          if (!panel) return;
          panel.hidden = false;
          panel.innerHTML = '<span style="color:var(--muted);">Loading tracking…</span>';
          btn.disabled = true;
          try {
            const data = await post(api.track, { order_id: Number(orderId) });
            if (!data.ok) {
              panel.innerHTML = `<span style="color:var(--danger);">${esc(data.message || 'Tracking unavailable')}</span>`;
              return;
            }
            const cps = Array.isArray(data.checkpoints) ? data.checkpoints : [];
            const head = [
              data.exchange_number ? `Last-mile: <strong>${esc(data.exchange_number)}</strong>` : '',
              data.tracking_status ? `Status: <strong>${esc(data.tracking_status)}</strong>` : '',
            ].filter(Boolean).join(' · ');
            if (!cps.length) {
              panel.innerHTML = `${head ? `<div style="margin-bottom:8px;">${head}</div>` : ''}<div style="color:var(--muted);">No checkpoint events yet. Check again later.</div>`;
              return;
            }
            panel.innerHTML = `
              ${head ? `<div style="margin-bottom:10px;">${head}</div>` : ''}
              <ol style="margin:0;padding-left:18px;">
                ${cps.map(cp => `<li style="margin:0 0 8px;">
                  <div><strong>${esc(cp.time || '')}</strong> ${cp.time_zone ? `<span style="color:var(--muted);">${esc(cp.time_zone)}</span>` : ''}</div>
                  <div>${esc(cp.message || cp.status || '')}</div>
                  ${cp.location ? `<div style="color:var(--muted);">${esc(cp.location)}</div>` : ''}
                </li>`).join('')}
              </ol>`;
          } catch (error) {
            panel.innerHTML = `<span style="color:var(--danger);">${esc(error.message || 'Tracking failed')}</span>`;
          } finally {
            btn.disabled = false;
          }
        });
      });
    }

    // ---- Event handlers ----
    $('sendCode').addEventListener('click', async () => {
      setMessage('loginMessage', 'Sending...');
      try {
        const data = await post(api.requestCode, { email: $('loginEmail').value });
        if (data.debug_code) {
          setMessage('loginMessage', `Debug code: ${data.debug_code}`);
        } else if (data.mail_sent === false) {
          setMessage(
            'loginMessage',
            data.message || 'Code was created but email delivery failed. Contact support or check admin mail queue.',
            true
          );
        } else {
          setMessage('loginMessage', data.message || 'Code sent. Check your email (and spam).');
        }
      } catch (error) {
        setMessage('loginMessage', error.message, true);
      }
    });

    $('verifyCode').addEventListener('click', async () => {
      setMessage('loginMessage', 'Signing in...');
      const btn = $('verifyCode');
      btn.disabled = true;
      try {
        const data = await post(api.login, { email: $('loginEmail').value, code: $('loginCode').value });
        // Login API already returns member — show account UI immediately even if a
        // follow-up session cookie race fails on the next request.
        if (data.member || data.authenticated) {
          state = {
            authenticated: true,
            member: data.member || { email: $('loginEmail').value },
            orders: [],
            addresses: [],
          };
          render();
        }
        await loadAccount();
        if (state.authenticated) {
          setMessage('loginMessage', '');
          $('loginCode').value = '';
        } else {
          setMessage(
            'loginMessage',
            'Sign-in was accepted, but the browser session cookie was not kept. Hard-refresh the page, or send a new code and try once more.',
            true
          );
        }
      } catch (error) {
        const msg = String(error.message || '');
        if (/invalid or expired/i.test(msg)) {
          setMessage(
            'loginMessage',
            'The sign-in code is invalid or expired (each code works only once). Click Send code for a new one.',
            true
          );
        } else {
          setMessage('loginMessage', msg, true);
        }
      } finally {
        btn.disabled = false;
      }
    });

    $('logoutButton').addEventListener('click', async () => {
      await post(api.logout, {});
      state = { authenticated: false, member: null, orders: [], addresses: [] };
      render();
    });

    $('saveProfile').addEventListener('click', async () => {
      setMessage('profileMessage', 'Saving...');
      try {
        await post(api.account, {
          action: 'profile',
          name: $('profileName').value,
          locale: $('profileLocale').value,
          currency: $('profileCurrency').value,
        });
        await loadAccount();
        setMessage('profileMessage', 'Profile saved.');
      } catch (error) {
        setMessage('profileMessage', error.message, true);
      }
    });

    $('saveAddress').addEventListener('click', async () => {
      setMessage('addressMessage', 'Saving...');
      try {
        await post(api.account, {
          action: 'save_address',
          address: {
            label: $('addrLabel').value,
            recipient_name: $('addrName').value,
            phone: $('addrPhone').value,
            country: $('addrCountry').value,
            postal_code: $('addrPostal').value,
            state: $('addrState').value,
            city: $('addrCity').value,
            line1: $('addrLine1').value,
            line2: $('addrLine2').value,
            is_default: true,
          },
        });
        await loadAccount();
        setMessage('addressMessage', 'Address saved.');
      } catch (error) {
        setMessage('addressMessage', error.message, true);
      }
    });

    // Init
    renderLanguageOptions();
    loadAccount();
  </script>
</Layout>
