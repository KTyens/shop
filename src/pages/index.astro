---
import { loadCatalog } from '../lib/catalog-data';
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import '../styles/global.css';
import {
  BRAND_DISCOVERY_KEYWORDS,
  CORE_SEO_KEYWORDS,
  SAFE_COMMERCE_KEYWORDS,
  itemListJsonLd,
  organizationJsonLd,
  storeFaqJsonLd,
  websiteJsonLd,
} from '../lib/seo';

const series = loadCatalog();

interface Variant {
  id: string;
  label: string;
  sku: string;
  price_cents: number;
  compare_at_cents?: number;
}

interface SeriesItem {
  id: string;
  name: string;
  brand: string;
  category: string;
  tier?: string;
  description: string;
  image: string;
  variants: Variant[];
  specs?: Record<string, string>;
  detail_url?: string;
}

const items = series as SeriesItem[];

function minPrice(item: SeriesItem) {
  return Math.min(...item.variants.map(v => v.price_cents));
}

function money(cents: number) {
  return `$${(cents / 100).toFixed(2)}`;
}

function assetUrl(path?: string) {
  if (!path) return '';
  if (path.startsWith('http') || path.startsWith('/')) return path;
  return `/${path}`;
}

function bulletSpecs(item: SeriesItem): string[] {
  const specs = item.specs || {};
  const preferred = ['Chipset', 'CPU', 'OS', 'Wi-Fi', 'Video Output', 'Memory', 'Storage', 'Brightness', 'Native Resolution'];
  const out: string[] = [];
  for (const key of preferred) {
    if (specs[key]) out.push(`${key}: ${specs[key]}`);
    if (out.length >= 4) break;
  }
  if (out.length < 4 && item.variants?.length) {
    out.push(`Configs: ${item.variants.map(v => v.label).slice(0, 3).join(' / ')}`);
  }
  while (out.length < 2) out.push(item.description.slice(0, 80));
  return out.slice(0, 4);
}

const featuredIds = [
  'h96max-h618-plus',
  'h96max-m1-plus',
  'h96-max-v58',
  'hk1-rbox-x4s',
  'hy320-mini-projector',
  'a10-projector',
];
const featured = featuredIds
  .map(id => items.find(i => i.id === id))
  .filter(Boolean) as SeriesItem[];

// fill if missing
while (featured.length < 6) {
  const next = items.find(i => !featured.some(f => f.id === i.id));
  if (!next) break;
  featured.push(next);
}

const heroProduct = items.find(i => i.id === 'h96max-m1-plus') ?? featured[0];
const catTv = items.find(i => i.category === 'tv-box') ?? heroProduct;
const catProj = items.find(i => i.category === 'projector') ?? featured.find(i => i.category === 'projector') ?? heroProduct;
const storyProduct = items.find(i => i.id === 'h96-max-v58') ?? heroProduct;

const fromPrice = Math.min(...items.flatMap(i => i.variants.map(v => v.price_cents)));

const homeKeywords = [
  ...CORE_SEO_KEYWORDS,
  ...BRAND_DISCOVERY_KEYWORDS,
  ...SAFE_COMMERCE_KEYWORDS,
  'best Android TV box',
  'buy Android TV box online',
  'premium TV boxes',
  'compact home projector',
  'MECOOL KM2 Plus',
  'MECOOL KM7 Plus',
  'X96 TV Box',
  'X98Q',
  'wireless HDMI WX50',
  'wireless HDMI WX100',
  'I8 mini keyboard',
  'T18+ mini keyboard',
  ...items.slice(0, 24).map((i) => i.name),
];
---

<Layout
  title="Android TV Boxes, Projectors, Wireless HDMI & Mini Keyboards | CRTLU Digital"
  description={`Shop Android TV boxes (H96, HK1, MECOOL, X96/X98), compact projectors, wireless HDMI kits, and mini keyboards. Official apps only, Stripe checkout, Yanwen shipping from ${money(fromPrice)}.`}
  keywords={homeKeywords}
  canonicalPath="/"
  image={assetUrl(heroProduct?.image) || '/assets/hero-cinema.jpg'}
  jsonLd={[
    websiteJsonLd(),
    organizationJsonLd(),
    storeFaqJsonLd(),
    itemListJsonLd('CRTLU Digital featured and catalog products', items.slice(0, 40)),
  ]}
>
  <Navigation currentPage="home" />

  <main id="main-content">
    <div class="checkout-cancelled" id="checkoutCancelled" role="status" hidden>
      <span data-i18n="home.checkoutCancelled">Checkout was cancelled. Your cart is still available when you return to the catalog.</span>
      <a href="/products/?cart=open" data-i18n="home.reviewCart">Review cart</a>
    </div>

    <!-- Hero -->
    <section class="el-hero">
      <div class="el-hero-copy">
        <div class="eyebrow" data-i18n="home.hero.eyebrow">Hand-picked home cinema hardware</div>
        <h1>
          <span data-i18n="home.hero.title1">Android TV boxes</span>
          <span data-i18n="home.hero.title2">&amp; compact projectors</span>
        </h1>
        <p data-i18n="home.hero.body">
          Clear specs, secure Stripe checkout, and tracked Yanwen shipping.
          Official apps only — bring your own subscriptions.
        </p>
        <div class="el-hero-actions">
          <a class="primary-button" href="#popular" data-i18n="home.hero.ctaPrimary">Explore collection</a>
          <a class="secondary-button" href="/products/" data-i18n="home.hero.ctaSecondary" data-i18n-vars={`{"price":"${money(fromPrice)}"}`}>From {money(fromPrice)} — all models</a>
        </div>
      </div>
      <div class="el-hero-stage" aria-label="TV box series video">
        <!--
          Do NOT wrap <video> in <a>: iOS Safari often blocks autoplay inside links,
          and taps navigate away instead of starting playback.
        -->
        <div class="el-hero-stage-frame el-hero-video-frame">
          <video
            class="el-hero-video"
            src="/assets/videos/category-tv-box.mp4"
            poster="/assets/videos/category-tv-box-poster.jpg"
            autoplay
            muted
            playsinline
            webkit-playsinline
            loop
            preload="auto"
            disablepictureinpicture
            data-hero-video
            aria-label="Android TV box series overview"
          ></video>
          <!-- Early start: run before main bundle / cart script so mobile can autoplay sooner -->
          <script is:inline>
            (function () {
              var v = document.querySelector('video[data-hero-video]');
              if (!v) return;
              v.muted = true;
              v.defaultMuted = true;
              v.volume = 0;
              v.playsInline = true;
              try {
                var p = v.play();
                if (p && p.catch) p.catch(function () {});
              } catch (e) {}
            })();
          </script>
          <button
            type="button"
            class="el-hero-video-play"
            data-hero-video-play
            hidden
            aria-label="Play video"
          >
            <span aria-hidden="true">▶</span>
          </button>
        </div>
        <div class="el-hero-caption">
          <span data-i18n="home.hero.videoCaption">TV Box series</span>
          <a class="el-hero-video-link" href="/products/?category=tv-box" data-i18n="home.hero.videoCta">Browse TV boxes →</a>
        </div>
      </div>
    </section>

    <!-- Trust strip -->
    <section class="el-trust" aria-label="Why shop with us">
      <div class="home-wrap">
        <div class="el-trust-grid">
          <div class="el-trust-item">
            <strong data-i18n="home.trust.stripe.title">Stripe checkout</strong>
            <span data-i18n="home.trust.stripe.body">Card details handled by Stripe — never stored on this site.</span>
          </div>
          <div class="el-trust-item">
            <strong data-i18n="home.trust.shipping.title">Tracked delivery</strong>
            <span data-i18n="home.trust.shipping.body">Yanwen shipping with a 7–18 business day transit estimate.</span>
          </div>
          <div class="el-trust-item">
            <strong data-i18n="home.trust.apps.title">Official apps only</strong>
            <span data-i18n="home.trust.apps.body">No piracy claims. Use Netflix, YouTube, and your own accounts.</span>
          </div>
          <div class="el-trust-item">
            <strong data-i18n="home.trust.returns.title">Returns &amp; warranty</strong>
            <span data-i18n="home.trust.returns.body">14-day return request window and 12-month limited hardware warranty.</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Categories -->
    <section class="el-categories" id="categories">
      <div class="home-wrap">
        <div class="section-head">
          <div>
            <div class="eyebrow" data-i18n="home.cats.eyebrow">Choose your setup</div>
            <h2 data-i18n="home.cats.title">High-performance home cinema</h2>
          </div>
          <p data-i18n="home.cats.lead">Start with the form factor that fits your room — streaming box or compact projector.</p>
        </div>
        <div class="el-cat-grid">
          <a class="el-cat-card" href="/products/?category=tv-box">
            <img src={assetUrl(catTv?.image)} alt="" loading="lazy" decoding="async" />
            <h3 data-i18n="home.cats.tvTitle">TV Boxes</h3>
            <p data-i18n="home.cats.tvBody">4K streamers and Android set-top boxes with clear memory configurations.</p>
            <span class="el-more" data-i18n="home.cats.more">More</span>
          </a>
          <a class="el-cat-card" href="/products/?category=projector">
            <img src={assetUrl(catProj?.image)} alt="" loading="lazy" decoding="async" />
            <h3 data-i18n="home.cats.projTitle">Projectors</h3>
            <p data-i18n="home.cats.projBody">Compact smart projectors for bedrooms, movie nights, and portable screens.</p>
            <span class="el-more" data-i18n="home.cats.more">More</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Marquee -->
    <div class="el-marquee" aria-hidden="true">
      <div class="el-marquee-track">
        <span data-i18n="home.marquee.pay">Stripe secure payment</span>
        <span data-i18n="home.marquee.ship">Yanwen tracked shipping</span>
        <span data-i18n="home.marquee.specs">Detailed product specs</span>
        <span data-i18n="home.marquee.warranty">12-month limited warranty</span>
        <span data-i18n="home.marquee.plugs">UK / EU / US plug options</span>
        <span data-i18n="home.marquee.apps">Official apps only</span>
        <span data-i18n="home.marquee.pay">Stripe secure payment</span>
        <span data-i18n="home.marquee.ship">Yanwen tracked shipping</span>
        <span data-i18n="home.marquee.specs">Detailed product specs</span>
        <span data-i18n="home.marquee.warranty">12-month limited warranty</span>
        <span data-i18n="home.marquee.plugs">UK / EU / US plug options</span>
        <span data-i18n="home.marquee.apps">Official apps only</span>
      </div>
    </div>

    <!-- Popular -->
    <section class="el-popular" id="popular">
      <div class="home-wrap">
        <div class="section-head">
          <div>
            <div class="eyebrow" data-i18n="home.popular.eyebrow">All-round performance</div>
            <h2 data-i18n="home.popular.title">Popular models</h2>
          </div>
          <a class="secondary-button" href="/products/" data-i18n="home.popular.viewAll">View all products</a>
        </div>
        <div class="product-grid">
          {featured.map((product) => (
            <article class="product-card">
              <a class="product-media-link" href={`/products/${product.id}/`} aria-label={`View ${product.name}`}>
                <div class="product-visual">
                  <img class="product-image" src={assetUrl(product.image)} alt={product.name} loading="lazy" decoding="async" />
                </div>
              </a>
              <div class="product-body">
                <div class="product-meta">
                  <span>{product.brand}</span>
                  <span>{(product.tier || product.category || '').replace('-', ' ')}</span>
                </div>
                <h3>
                  <a class="product-card-link" href={`/products/${product.id}/`}>{product.name}</a>
                </h3>
                <ul class="product-bullets">
                  {bulletSpecs(product).map((line) => <li>{line}</li>)}
                </ul>
                <div class="product-footer">
                  <div class="price">
                    <span data-i18n="home.popular.from">from</span> {money(minPrice(product))}
                    <small data-i18n="common.usd">USD</small>
                  </div>
                  <a class="primary-button" href={`/products/${product.id}/`} style="padding:0 14px;font-size:11px;" data-i18n="product.details">
                    View
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Story -->
    <section class="el-story">
      <div class="home-wrap">
        <div class="el-story-grid">
          <div class="el-story-visual">
            <img src={assetUrl(storyProduct?.image)} alt={storyProduct?.name ?? 'Featured hardware'} loading="lazy" decoding="async" />
          </div>
          <div>
            <div class="eyebrow" data-i18n="home.story.eyebrow">More than a listing</div>
            <h2 data-i18n="home.story.title">Specs you can trust before checkout</h2>
            <p data-i18n="home.story.body">
              Every published model carries structured specifications — chipset, system, wireless,
              ports, and package details — so you can compare configurations without guessing.
              Payment stays on Stripe; fulfillment uses tracked Yanwen shipping.
            </p>
            <a class="primary-button" href="/products/" data-i18n="home.story.cta">Browse the full catalog</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Compare -->
    <section class="el-compare">
      <div class="home-wrap">
        <div class="section-head">
          <div>
            <div class="eyebrow" data-i18n="home.compare.eyebrow">Buyer guidance</div>
            <h2 data-i18n="home.compare.title">Pick a tier faster</h2>
          </div>
          <p data-i18n="home.compare.lead">A simple map from use case to the models most buyers start with.</p>
        </div>
        <div class="el-compare-table">
          <div class="el-compare-row head">
            <div class="el-compare-cell" data-i18n="home.compare.useCase">Use case</div>
            <div class="el-compare-cell" data-i18n="home.compare.budget">Budget</div>
            <div class="el-compare-cell" data-i18n="home.compare.mainstream">Mainstream</div>
            <div class="el-compare-cell" data-i18n="home.compare.performance">Performance</div>
            <div class="el-compare-cell" data-i18n="home.compare.flagship">Flagship</div>
          </div>
          <div class="el-compare-row">
            <div class="el-compare-cell label" data-i18n="home.compare.row1">Daily streaming</div>
            <div class="el-compare-cell">H96Max H313 / X5</div>
            <div class="el-compare-cell">H96Max M1 Plus</div>
            <div class="el-compare-cell">HK1 RBOX X4S</div>
            <div class="el-compare-cell">H96 MAX V58</div>
          </div>
          <div class="el-compare-row">
            <div class="el-compare-cell label" data-i18n="home.compare.row2">Key reason</div>
            <div class="el-compare-cell" data-i18n="home.compare.row1b">Lowest entry price</div>
            <div class="el-compare-cell" data-i18n="home.compare.row1c">Best launch balance</div>
            <div class="el-compare-cell" data-i18n="home.compare.row1d">More storage options</div>
            <div class="el-compare-cell" data-i18n="home.compare.row1e">RK3588 / Wi-Fi 6</div>
          </div>
          <div class="el-compare-row">
            <div class="el-compare-cell label" data-i18n="home.compare.row3">Ideal buyer</div>
            <div class="el-compare-cell" data-i18n="home.compare.buyer1">Price-sensitive</div>
            <div class="el-compare-cell" data-i18n="home.compare.buyer2">Family TV room</div>
            <div class="el-compare-cell" data-i18n="home.compare.buyer3">Spec comparison</div>
            <div class="el-compare-cell" data-i18n="home.compare.buyer4">High-performance</div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script>
    const cartKey = 'crtlu-cart-v1';
    let cart = [];
    try { cart = JSON.parse(localStorage.getItem(cartKey) || '[]'); } catch { cart = []; }

    function renderCart() {
      const count = cart.reduce((sum, item) => sum + (item.qty || 0), 0);
      const el = document.getElementById('cartCount');
      if (el) el.textContent = String(count);
    }

    function openCart() {
      window.location.href = '/products/?cart=open';
    }

    const openBtn = document.getElementById('openCart');
    if (openBtn) openBtn.addEventListener('click', openCart);
    const mobileCartBtn = document.getElementById('mobileOpenCart');
    if (mobileCartBtn) mobileCartBtn.addEventListener('click', openCart);

    const checkoutCancelled = document.getElementById('checkoutCancelled');
    if (checkoutCancelled && new URLSearchParams(window.location.search).get('checkout') === 'cancelled') {
      checkoutCancelled.hidden = false;
    }

    renderCart();

    // Hero video: maximize muted autoplay success; play button only after retries fail
    (function initHeroVideo() {
      const video = document.querySelector('video[data-hero-video]') as HTMLVideoElement | null;
      if (!video) return;
      const playBtn = document.querySelector('[data-hero-video-play]') as HTMLButtonElement | null;
      const reduce = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);

      let attempts = 0;
      let isPlaying = false;
      let btnTimer: ReturnType<typeof setTimeout> | 0 = 0;
      let gestureBound = false;

      const prime = () => {
        video.muted = true;
        video.defaultMuted = true;
        video.volume = 0;
        video.playsInline = true;
        video.setAttribute('playsinline', '');
        video.setAttribute('webkit-playsinline', '');
        video.setAttribute('muted', '');
        video.setAttribute('autoplay', '');
      };

      const hidePlayBtn = () => {
        if (btnTimer) {
          clearTimeout(btnTimer);
          btnTimer = 0;
        }
        if (playBtn) playBtn.hidden = true;
      };

      /** Only show fallback after sustained failure — avoid flash while buffering. */
      const schedulePlayBtn = () => {
        if (!playBtn || isPlaying || !video.paused) return;
        if (btnTimer) return;
        btnTimer = setTimeout(() => {
          btnTimer = 0;
          if (!isPlaying && video.paused) playBtn.hidden = false;
        }, 1600);
      };

      const playSafe = () => {
        if (reduce || isPlaying) return;
        prime();
        attempts += 1;
        let p: Promise<void> | undefined;
        try {
          p = video.play();
        } catch {
          if (attempts >= 3) schedulePlayBtn();
          return;
        }
        if (p && typeof p.then === 'function') {
          p.then(() => {
            isPlaying = !video.paused;
            if (isPlaying) hidePlayBtn();
          }).catch(() => {
            // NotAllowedError / AbortError — keep retrying; button later
            if (attempts >= 5) schedulePlayBtn();
          });
        } else if (!video.paused) {
          isPlaying = true;
          hidePlayBtn();
        } else if (attempts >= 5) {
          schedulePlayBtn();
        }
      };

      if (reduce) {
        video.removeAttribute('autoplay');
        video.pause();
        if (playBtn) playBtn.hidden = false;
      } else {
        prime();
        // Do not wait for IntersectionObserver — hero is above the fold
        playSafe();
        requestAnimationFrame(() => playSafe());
        [80, 200, 500, 1000, 2000, 3500].forEach((ms) => {
          setTimeout(() => {
            if (!isPlaying && video.paused) playSafe();
          }, ms);
        });

        const onReady = () => {
          if (!isPlaying && video.paused) playSafe();
        };
        video.addEventListener('loadedmetadata', onReady);
        video.addEventListener('loadeddata', onReady);
        video.addEventListener('canplay', onReady);
        video.addEventListener('canplaythrough', onReady);
        video.addEventListener('playing', () => {
          isPlaying = true;
          hidePlayBtn();
        });
        video.addEventListener('pause', () => {
          // User/system pause — allow resume attempts unless fully off-screen handled below
          isPlaying = false;
        });

        // Pause only when fully off-screen; resume as soon as any pixel is visible
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  if (video.paused) playSafe();
                } else {
                  video.pause();
                  isPlaying = false;
                }
              });
            },
            { threshold: 0, rootMargin: '40px 0px' }
          );
          io.observe(video);
        }

        // Any early page gesture unlocks autoplay policies (iOS / strict Chrome)
        const unlock = () => {
          if (video.paused) playSafe();
        };
        const bindGestures = () => {
          if (gestureBound) return;
          gestureBound = true;
          ['touchstart', 'pointerdown', 'click', 'scroll', 'wheel'].forEach((ev) => {
            document.addEventListener(ev, unlock, { passive: true, capture: true });
          });
        };
        bindGestures();

        document.addEventListener('visibilitychange', () => {
          if (!document.hidden && video.paused) {
            isPlaying = false;
            playSafe();
          }
        });
        // Do not call video.load() here — it aborts an in-flight autoplay started by the inline script.
      }

      if (playBtn) {
        playBtn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          prime();
          const p = video.play();
          if (p && typeof p.then === 'function') {
            p.then(() => {
              isPlaying = true;
              hidePlayBtn();
            }).catch(() => schedulePlayBtn());
          }
        });
      }
    })();
  </script>
</Layout>
